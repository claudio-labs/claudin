#!/usr/bin/env node

/**
 * Claudin — Claude Code with any LLM
 *
 * If dist/cli.mjs exists (built), run that.
 * Otherwise, tell the user to build first or use `bun run dev`.
 */

import { spawnSync } from 'child_process'
import { existsSync, mkdirSync } from 'fs'
import * as module from 'module'
import { homedir } from 'os'
import { join, dirname } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'

// V8 default old-space cap is 4 GB on 64-bit. Long Opus/Gemini sessions can
// hit it (parsed bundle + React/Ink tree + tool-result strings + cached file
// contents) before the heap-pressure autocompact trigger fires. Re-exec
// once with a higher cap so the trigger has room to run summary before OOM.
// Override via CLAUDIN_MAX_HEAP_MB; opt out with CLAUDIN_NO_HEAP_BUMP=1.
const HEAP_BUMP_SENTINEL = '_CLAUDIN_HEAP_BUMPED'
if (
  !process.env[HEAP_BUMP_SENTINEL] &&
  process.env.CLAUDIN_NO_HEAP_BUMP !== '1' &&
  !(process.env.NODE_OPTIONS || '').includes('max-old-space-size') &&
  !process.execArgv.some(a => a.startsWith('--max-old-space-size'))
) {
  const heapMB = process.env.CLAUDIN_MAX_HEAP_MB || '8192'
  // --expose-gc lets the runtime hint V8 to mark-sweep at natural release
  // points (post-compact, post-subagent cleanup) instead of waiting for an
  // allocation-driven GC. Negligible perf overhead; opt out via
  // CLAUDIN_NO_HEAP_BUMP=1 if needed.

  // Memory allocator strategy for long-running REPL sessions:
  // 1. jemalloc (preferred) — aggressive dirty-page purging, low fragmentation,
  //    RSS drops after GC. Used by Redis, Firefox, Chrome (PartitionAlloc cousin).
  // 2. glibc malloc fallback — with MALLOC_TRIM/MMAP thresholds so freed pages
  //    return to the OS. Better than mimalloc (V8 default) which retains pages.
  // Opt out via CLAUDIN_MALLOC=default (use V8's built-in allocator as-is).
  const mallocEnv = {}
  const mallocStrategy = process.env.CLAUDIN_MALLOC || 'auto'
  let ldPreload = process.env.LD_PRELOAD || ''

  if (mallocStrategy !== 'default') {
    // Candidate jemalloc paths (common distro locations)
    const jemallocPaths = [
      '/usr/lib/x86_64-linux-gnu/libjemalloc.so.2',    // Debian/Ubuntu
      '/usr/lib64/libjemalloc.so.2',                     // RHEL/Fedora
      '/usr/lib/libjemalloc.so.2',                       // Alpine/Arch
      '/usr/lib/aarch64-linux-gnu/libjemalloc.so.2',    // ARM64 Debian/Ubuntu
    ]
    const jemallocPath = jemallocPaths.find(p => {
      try { return existsSync(p) } catch { return false }
    })

    if (jemallocPath) {
      // jemalloc found — prepend to LD_PRELOAD
      ldPreload = ldPreload ? `${jemallocPath}:${ldPreload}` : jemallocPath
    } else if (mallocStrategy === 'jemalloc') {
      // User explicitly requested jemalloc but it's not installed
      console.warn('claudin: CLAUDIN_MALLOC=jemalloc but libjemalloc not found. Falling back to glibc malloc tuning.')
    }
  }

  // glibc malloc tuning (harmless under jemalloc — it ignores env vars it
  // doesn't recognize, and these are glibc-specific). Only set when NOT
  // using jemalloc (or as a fallback when jemalloc isn't available).
  if (!ldPreload.includes('jemalloc') && mallocStrategy !== 'default') {
    mallocEnv.MALLOC_MMAP_THRESHOLD_ = process.env.MALLOC_MMAP_THRESHOLD_ || '131072'
    mallocEnv.MALLOC_TRIM_THRESHOLD_ = process.env.MALLOC_TRIM_THRESHOLD_ || '65536'
    mallocEnv.MALLOC_MMAP_MAX_ = process.env.MALLOC_MMAP_MAX_ || '0'
  }

  const result = spawnSync(
    process.execPath,
    [`--max-old-space-size=${heapMB}`, '--expose-gc', ...process.execArgv, fileURLToPath(import.meta.url), ...process.argv.slice(2)],
    {
      stdio: 'inherit',
      env: {
        ...process.env,
        [HEAP_BUMP_SENTINEL]: '1',
        // libuv thread pool default is 4 — every fs/dns/crypto/zlib op shares
        // it. With concurrent Read/Glob/Grep/WebFetch under one turn the pool
        // queues. Bumping to 10 gives the agent enough parallelism for
        // typical multi-tool dispatches without the overhead of unbounded
        // pools. Costs ~6 idle threads at ~100 KB native each (~600 KB).
        // Respects pre-existing UV_THREADPOOL_SIZE if user set their own.
        UV_THREADPOOL_SIZE: process.env.UV_THREADPOOL_SIZE || '10',
        ...(ldPreload ? { LD_PRELOAD: ldPreload } : {}),
        ...mallocEnv,
      },
    },
  )
  process.exit(result.status ?? 1)
}

const __dirname = dirname(fileURLToPath(import.meta.url))
const distPath = join(__dirname, '..', 'dist', 'cli.mjs')

// V8 bytecode cache for the 21 MB bundle. ~250 ms saved on every warm launch
// (measured); first run after each build pays ~120 ms to populate. Must be
// enabled before the dynamic import below so V8 reuses cached bytecode for
// the bundle. NODE_COMPILE_CACHE env var only applies at process startup, so
// we use the programmatic API (Node ≥22.8 / ≥20.18). Pre-existing env var
// or NODE_DISABLE_COMPILE_CACHE=1 are respected.
if (
  typeof module.enableCompileCache === 'function' &&
  process.env.NODE_DISABLE_COMPILE_CACHE !== '1' &&
  !process.env.NODE_COMPILE_CACHE
) {
  const cacheRoot = process.env.CLAUDIN_CONFIG_DIR || join(homedir(), '.claudin')
  const v8Cache = join(cacheRoot, 'v8cache')
  try {
    mkdirSync(v8Cache, { recursive: true })
    module.enableCompileCache(v8Cache)
  } catch {
    // Non-fatal: launcher continues without cache.
  }

  // Lazy GC of stale entries. Node's enableCompileCache never reclaims old
  // entries, and after code-splitting the cache accumulates hundreds of
  // chunks per build. Sweep async after enabling cache (V8 only touches
  // entries matching current bundle hash; stale ones are orphans).
  // Opt out via CLAUDIN_V8CACHE_GC=0; tune via CLAUDIN_V8CACHE_TTL_DAYS.
  if (process.env.CLAUDIN_V8CACHE_GC !== '0') {
    const ttlDays = Number(process.env.CLAUDIN_V8CACHE_TTL_DAYS) || 14
    if (ttlDays > 0) {
      const gcUrl = pathToFileURL(join(__dirname, '..', 'scripts', 'v8cache-gc.mjs')).href
      import(gcUrl)
        .then(m => m.gcV8Cache(v8Cache, { ttlDays }))
        .catch(() => {}) // Non-fatal.
    }
  }
}

if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href)
} else {
  console.error(`
  claudin: dist/cli.mjs not found.

  Build first:
    bun run build

  Or run directly with Bun:
    bun run dev

  See README.md for setup instructions.
`)
  process.exit(1)
}
