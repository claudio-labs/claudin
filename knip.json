{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/platform/entrypoints/cli.tsx",
    "src/platform/entrypoints/mcp.ts",
    "src/platform/entrypoints/init.ts",
    "src/platform/main.tsx",
    "scripts/**/*.{ts,mjs}",
    "bin/claudin",
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignore": [
    "src/types/generated/**",
    "src/platform/entrypoints/sdk/coreTypes.generated.ts",
    "src/stubs/growthbook-stub.ts",
    "src/stubs/sandbox-runtime-stub.ts"
  ],
  "ignoreDependencies": [
    "@anthropic-ai/vertex-sdk",
    "@anthropic-ai/foundry-sdk",
    "@opentelemetry/.+"
  ],
  "ignoreBinaries": [
    "arecord",
    "caffeinate",
    "claudindev",
    "rec",
    "secret-tool",
    "wslpath"
  ]
}
