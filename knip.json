{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/entrypoints/cli.tsx",
    "src/entrypoints/mcp.ts",
    "src/entrypoints/init.ts",
    "src/main.tsx",
    "scripts/**/*.{ts,mjs}",
    "bin/claudin",
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}"
  ],
