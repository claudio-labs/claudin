{
  "name": "@claudiolabs/claudin",
  "version": "1.1.14",
  "description": "Claudin — Claude Code opened to any LLM (OpenAI, Gemini, DeepSeek, Ollama, and 200+ models)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudio-labs/claudin.git"
  },
  "homepage": "https://github.com/claudio-labs/claudin#readme",
  "bugs": {
    "url": "https://github.com/claudio-labs/claudin/issues"
  },
  "bin": {
    "claudin": "./bin/claudin"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/v8cache-gc.mjs",
    "scripts/postinstall-warmup.mjs",
    "!scripts/README.md",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build/build.ts",
    "build:strict": "CLAUDIN_STRICT_IMPORTS=1 bun run scripts/build/build.ts",
    "build:strict:baseline": "CLAUDIN_STRICT_IMPORTS=capture bun run scripts/build/build.ts",
    "postinstall": "node scripts/postinstall-warmup.mjs",
    "setup": "bun install && bun run build && bun link",
    "link": "bun link",
    "link:dev": "bun run scripts/build/link-dev.ts",
    "dev": "bun run build && node dist/cli.mjs",
    "start": "node dist/cli.mjs",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage --max-concurrency=1 && bun run scripts/codegen/render-coverage-heatmap.ts",
    "test:coverage:ui": "bun run scripts/codegen/render-coverage-heatmap.ts",
    "test:floor": "bun run scripts/verify/test-floor.ts",
    "test:floor:update": "bun run scripts/verify/test-floor.ts --update",
    "security:pr-scan": "bun run scripts/verify/pr-intent-scan.ts",
    "deadcode": "knip --include files,dependencies",
    "deadcode:ci": "knip --include files,dependencies,devDependencies --no-config-hints",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "bun run scripts/verify/typecheck-ci.ts",
    "typecheck:baseline": "bun run scripts/verify/typecheck-ci.ts --update",
    "generate:sdk-types": "bun run scripts/codegen/generate-sdk-types.ts",
    "verify:sdk-types": "bun run scripts/codegen/generate-sdk-types.ts --check",
    "verify:rules": "bun run scripts/verify/rules-check.ts",
    "smoke": "bun run build && node dist/cli.mjs --version && node dist/cli.mjs --help >/dev/null",
    "smoke:hello": "bun run scripts/verify/smoke-hello.ts",
    "verify:privacy": "bun run scripts/verify/verify-no-phone-home.ts",
    "build:verified": "bun run build && bun run verify:privacy",
    "build:release": "CLAUDIN_RELEASE_BUILD=1 bun run build",
    "build:compile": "CLAUDIN_COMPILE=1 bun run scripts/build/build.ts",
    "build:compile:all": "bun run scripts/build/build-compile-all.ts",
    "vendor:ripgrep": "bun run scripts/build/vendor-ripgrep.ts",
    "vendor:sharp": "bun run scripts/build/vendor-sharp.ts",
    "build:packages": "bun run scripts/release/assemble-packages.ts",
    "test:provider": "bun test src/providers/ src/agent/context/context.test.ts",
    "profile": "bun run scripts/bench/perf/run-all.ts",
    "profile:streaming": "bun run scripts/bench/perf/streaming-bench.ts --compare",
    "profile:input": "bun run scripts/bench/perf/input-bench.ts",
    "profile:cold-start": "bun run scripts/bench/perf/cold-start-bench.ts",
    "profile:startup-phases": "bun run scripts/bench/perf/startup-phases-bench.ts",
    "profile:memory": "bun run scripts/bench/perf/memory-bench.ts",
    "profile:transcript": "bun run scripts/bench/perf/transcript-bench.ts --with-code",
    "profile:long-session": "bun --expose-gc run scripts/bench/perf/long-session-bench.ts",
    "profile:query-engine-mem": "bun --expose-gc run scripts/bench/perf/query-engine-mem-bench.ts",
    "profile:streaming-shim": "bun --expose-gc run scripts/bench/perf/streaming-shim-bench.ts",
    "profile:skills-plugin": "bun --expose-gc run scripts/bench/perf/skills-plugin-bench.ts",
    "profile:file-read-cache-saturation": "bun --expose-gc run scripts/bench/perf/file-read-cache-saturation-bench.ts",
    "profile:heap-snapshot-diff": "bun --expose-gc run scripts/bench/perf/heap-snapshot-diff-bench.ts",
    "profile:code-outline": "bun run scripts/bench/perf/code-outline-bench.ts",
    "profile:turn": "bun run scripts/bench/perf/turn-cpu-bench.ts",
    "profile:mem": "bun --expose-gc run scripts/bench/perf/memory-turn-by-turn-bench.ts",
    "profile:mem:500": "bun --expose-gc run scripts/bench/perf/memory-turn-by-turn-bench.ts --turns=500 --payload-kb=200 --payload-jitter=100 --with-compact --with-clear --compact-every=100 --clear-every=200 --inflection --output=scripts/bench/perf/baselines/memory-turn-by-turn.json --csv=scripts/bench/perf/baselines/memory-turn-by-turn.csv",
    "profile:mem:ci": "bun --expose-gc run scripts/bench/perf/memory-turn-by-turn-bench.ts --turns=100 --payload-kb=50 --with-compact --with-clear --compact-every=25 --clear-every=50 --inflection --json",
    "prepack": "npm run build:release && npm run verify:privacy"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/foundry-sdk": "0.4.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@commander-js/extra-typings": "15",
    "@mendable/firecrawl-js": "^4.29.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "ajv": "^8.20.0",
    "auto-bind": "5.0.1",
    "axios": "^1.18.1",
    "bidi-js": "1.0.3",
    "chalk": "6.0.0",
    "chokidar": "5.0.0",
    "cli-boxes": "4",
    "cli-highlight": "2.1.11",
    "commander": "15",
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "duck-duck-scrape": "^2.2.7",
    "emoji-regex": "10.6.0",
    "env-paths": "4",
    "execa": "10.0.1",
    "fflate": "0.8.3",
    "figures": "6.1.0",
    "fuse.js": "^7.4.2",
    "get-east-asian-width": "^1.6.0",
    "google-auth-library": "^11.0.0",
    "https-proxy-agent": "9.1.0",
    "ignore": "7.0.6",
    "indent-string": "5.0.0",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.1",
    "lru-cache": "^11.5.1",
    "marked": "18.0.9",
    "p-map": "7.0.6",
    "picomatch": "4.0.5",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "^19.2.7",
    "react-compiler-runtime": "1.0.0",
    "react-reconciler": "0.33.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "shell-quote": "1.10.0",
    "signal-exit": "4.1.0",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "4",
    "tree-kill": "1.2.2",
    "turndown": "^7.2.4",
    "type-fest": "^5.7.0",
    "undici": "8.10.0",
    "usehooks-ts": "3.1.1",
    "vscode-languageserver-protocol": "3.18.2",
    "wrap-ansi": "10",
    "ws": "^8.21.0",
    "xss": "1.0.15",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cross-spawn": "^6.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.0",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "knip": "^6.32.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "claude-code",
    "openai",
    "llm",
    "cli",
    "agent",
    "deepseek",
    "ollama",
    "gemini"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@anthropic-ai/sdk": "$@anthropic-ai/sdk",
    "google-auth-library": "$google-auth-library",
    "lodash-es": "4.18.1"
  }
}
