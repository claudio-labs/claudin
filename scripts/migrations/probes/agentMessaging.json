    {
      "name": "a wait on someone unreachable is refused before sending",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "  if (agentId !== undefined) return { agentId }\n",
      "replace": "  return { agentId }\n"
