      "find": "    sent = (await send({ ...input, await_reply: undefined, notify_when_idle: target.peer })).data\n",
      "replace": "    sent = (await send({ ...input, await_reply: undefined })).data\n"
    },
    {
      "name": "a bare wait on a session still subscribes",
