    {
      "name": "another agent cannot restart one the user stopped",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "  if (status === 'killed' && context.agentId !== undefined) {\n",
      "replace": "  if (false) {\n"
    },
    {
      "name": "a send arriving mid-resume joins the run",
      "source": "src/tools/SendMessageTool/resumeOnce.ts",
      "find": "  if (starting) {\n",
      "replace": "  if (false) {\n"
    },
    {
      "name": "a settled resume no longer holds the agent",
      "source": "src/tools/SendMessageTool/resumeOnce.ts",
      "find": "    inFlight.delete(agentId)\n",
      "replace": "\n"
    },
    {
      "name": "the completion notice carries unread messages",
      "source": "src/agent/tasks/LocalAgentTask/LocalAgentTask.tsx",
      "find": "    unread = describeUnreadMessages(task.pendingMessages);\n",
      "replace": "\n"
    },
    {
      "name": "unread messages are described",
      "source": "src/agent/messages/interAgentMessages.ts",
      "find": "  if (pending.length === 0) return undefined\n",
      "replace": "  if (true) return undefined\n"
    }
  ]
