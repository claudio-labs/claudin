{
  "test": [
    "src/tools/SendMessageTool/SendMessageTool.regression.test.ts",
    "src/tools/SendMessageTool/SendMessageTool.test.ts",
    "src/agent/messages/interAgentMessages.test.ts",
    "src/tools/SendMessageTool/awaitReply.test.ts",
