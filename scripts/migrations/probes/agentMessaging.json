    },
    {
      "name": "a sub-agent cannot wait on another session",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "  if (context.agentId !== undefined) {\n    throw new Error(\n      `A reply from another session",
      "replace": "  if (false) {\n    throw new Error(\n      `A reply from another session"
