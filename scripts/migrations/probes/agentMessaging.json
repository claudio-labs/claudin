      "find": "        return input.notify_when_idle || input.await_reply\n",
      "replace": "        return input.notify_when_idle\n"
    },
    {
      "name": "replies reach the model as text",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "      if ('replies' in data && data.replies && data.replies.length > 0) {\n",
      "replace": "      if (false) {\n"
