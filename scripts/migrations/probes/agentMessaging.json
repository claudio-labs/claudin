      "find": "      relation: agent.attrs.from === MAIN_ADDRESS ? 'main conversation' : 'background agent',\n",
      "replace": "      relation: 'background agent',\n"
    },
    {
      "name": "the wrapper names the sender",
      "source": "src/agent/messages/text.ts",
      "find": "      return `${origin.name === MAIN_ADDRESS ? 'The main conversation' : `Agent \"${origin.name}\"`} sent you a message while you were working:\\n${raw}\\n\\nAddress this before completing your current task.`\n",
      "replace": "      return `The coordinator sent a message while you were working:\\n${raw}\\n\\nAddress this before completing your current task.`\n"
    },
    {
      "name": "a reply ends the wait",
      "source": "src/tools/SendMessageTool/awaitReply.ts",
      "find": "    if (messages.length > 0) return { kind: 'replied', messages }\n",
      "replace": "    if (false) return { kind: 'replied', messages }\n"
    },
    {
      "name": "the user writing ends the wait",
      "source": "src/tools/SendMessageTool/awaitReply.ts",
      "find": "    if (probe.userWrote()) return { kind: 'user-wrote' }\n",
      "replace": "    if (false) return { kind: 'user-wrote' }\n"
