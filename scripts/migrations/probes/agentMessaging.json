      "replace": "          const letter = input.message\n"
    },
    {
      "name": "main signs its messages as main",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "  if (agentId === undefined) return { from: MAIN_ADDRESS }\n",
      "replace": "  if (agentId === undefined) return { from: 'coordinator' }\n"
    },
    {
      "name": "an unnamed sender carries its description",
      "source": "src/tools/SendMessageTool/SendMessageTool.ts",
      "find": "  return { from: agentId, description: isLocalAgentTask(task) ? task.description : undefined }\n",
      "replace": "  return { from: agentId }\n"
    },
    {
      "name": "the trailer tells a sub-agent the message is from main",
      "source": "src/tools/SendMessageTool/agentMessage.ts",
      "find": "        ? 'the main conversation, which launched you'\n",
      "replace": "        ? 'another agent of this conversation'\n"
    },
    {
