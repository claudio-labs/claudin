{
  "test": [
    "src/tools/shared/outputFilter/Bash/lineBound.test.ts",
    "src/tools/shared/outputFilter/Bash/floor.test.ts"
  ],
  "source": "src/tools/shared/outputFilter/Bash/lineBound.ts",
  "probes": [
    {
      "name": "line-bound: a substitution is followed",
      "find": "  if (SUBSTITUTION_RE.test(command)) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: an output redirect is followed",
      "find": "if (!walked || walked.hasOutputRedirection) return null;",
      "replace": "if (!walked) return null;"
    },
    {
      "name": "line-bound: a command with no read counts",
      "find": "return top.read ? top.lines : null;",
      "replace": "return top.lines;"
    },
    {
      "name": "line-bound: sed without -n counts",
      "find": "  if (!quiet) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a pattern command in a sed script is skipped",
      "find": "    if (!match) return null;",
      "replace": "    if (!match) continue;"
    },
    {
      "name": "line-bound: sed -s ignores how many files",
      "find": "if (!separate || positional.length === 0) return { lines, files: positional };",
      "replace": "return { lines, files: positional };"
    },
    {
      "name": "line-bound: tail -n +N and head -n -N count",
      "find": "      if (!COUNT_RE.test(count)) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a glob in head is one file",
      "find": "  if (count === null) return null;\n  if (count === 1) return { lines, files };",
      "replace": "  if (count === 1) return { lines, files };"
    },
    {
      "name": "line-bound: head over several files prints no headers",
      "find": "return { lines: count * (lines + 2), files };",
      "replace": "return { lines: count * lines, files };"
    },
    {
      "name": "line-bound: an awk body may do anything",
      "find": "  if (body !== undefined && (!AWK_PRINT_BODY_RE.test(body) || AWK_SIDE_EFFECT_RE.test(body))) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a print body may call system",
      "find": " || AWK_SIDE_EFFECT_RE.test(body)",
      "replace": ""
    },
    {
      "name": "line-bound: a backwards awk range closes",
      "find": "    if (to < from) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a range print alone reads stdin",
      "find": "if (at === 0 ? bound.files.length === 0 : bound.files.length > 0) return null;",
      "replace": "if (at === 0 ? false : bound.files.length > 0) return null;"
    },
    {
      "name": "line-bound: a bound past the head may read its own file",
      "find": "if (at === 0 ? bound.files.length === 0 : bound.files.length > 0) return null;",
      "replace": "if (at === 0 ? bound.files.length === 0 : false) return null;"
    },
    {
      "name": "line-bound: any producer feeds a bound",
      "find": "  if (!stages.slice(0, at).every(isBoundedFeed)) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: anything may follow the bound",
      "find": "  if (!stages.slice(at + 1).every(isLineFilter)) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a grep after the bound may split lines (-o)",
      "find": "return operands.length === 1 && flags.every((flag) => GREP_FILTER_FLAGS_RE.test(flag.text));",
      "replace": "return operands.length === 1;"
    },
    {
      "name": "line-bound: a grep after the bound may read a file",
      "find": "return operands.length === 1 && flags.every((flag) => GREP_FILTER_FLAGS_RE.test(flag.text));",
      "replace": "return flags.every((flag) => GREP_FILTER_FLAGS_RE.test(flag.text));"
    },
    {
      "name": "line-bound: a cat after the bound may read a file",
      "find": "if (FILE_PRINTERS.has(head.text)) return operands.length === 0;",
      "replace": "if (FILE_PRINTERS.has(head.text)) return true;"
    },
    {
      "name": "line-bound: bare head prints nothing",
      "find": "const DEFAULT_HEAD_TAIL_LINES = 10;",
      "replace": "const DEFAULT_HEAD_TAIL_LINES = 0;"
    },
    {
      "name": "line-bound: $DIR/path is not one file",
      "find": "if (!loopVariable && !ONE_EXPANDED_PATH_RE.test(word.text)) return null;",
      "replace": "if (!loopVariable) return null;"
    },
    {
      "name": "line-bound: a loop variable is not one file",
      "find": "const loopVariable = word.text.startsWith(\"$\") && scope.loopVariables.has(word.text.slice(1));",
      "replace": "const loopVariable = false;"
    },
    {
      "name": "line-bound: a loop over a glob counts its words",
      "find": "      if (list.length === 0 || list.some((word) => word.glob || EXPANDED_WORD_RE.test(word.text))) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: a loop body counts once",
      "find": "into.lines += loop.passes * loop.lines;",
      "replace": "into.lines += loop.lines;"
    },
    {
      "name": "line-bound: an unclosed loop is ignored",
      "find": "  if (awaitingDo || loops.length > 0) return null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: an assignment is not glue",
      "find": "  if (words.every((word) => ASSIGNMENT_RE.test(word.text))) return 0;\n",
      "replace": ""
    },
    {
      "name": "line-bound: || true is not glue",
      "find": "  if (SILENT_COMMANDS.has(head.text)) return args.length === 0 ? 0 : null;\n",
      "replace": ""
    },
    {
      "name": "line-bound: git show of a commit feeds a bound",
      "find": "return head.text === \"git\" && args[0]?.text === \"show\" && args.slice(1).some((arg) => arg.text.includes(\":\"));",
      "replace": "return head.text === \"git\" && args[0]?.text === \"show\";"
    },
    {
      "name": "line-bound: grep without -c is glue",
      "find": "if (!pattern || !flags.some((flag) => GREP_COUNT_FLAGS_RE.test(flag.text))) return null;",
      "replace": "if (!pattern) return null;"
    }
  ]
}
