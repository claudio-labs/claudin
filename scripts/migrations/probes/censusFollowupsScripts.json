{
  "test": [
    "scripts/bench/tokens/feature-usage-census.test.ts",
    "scripts/bench/tokens/session-census.test.ts",
    "scripts/dev/tui-probe.test.ts"
  ],
  "source": "scripts/bench/tokens/feature-usage-census.ts",
  "probes": [
    {
      "name": "census: a range in --since passes as a date",
      "find": "  if (DATE_RE.test(value) && ",
      "replace": "  if (true || "
    },
    {
      "name": "census: an empty window exits 1 again",
      "find": "    return\n  }\n  if (args.dump) {\n",
      "replace": "    process.exit(1)\n  }\n  if (args.dump) {\n"
    },
    {
      "name": "census: --project reads only the first of a list",
      "find": "args.projects.flatMap(p => projectDirs(p))",
      "replace": "projectDirs(args.projects[0])"
    },
    {
      "name": "census: --dump writes no rows",
      "find": "    writeFileSync(args.dump, dumpRows(calls, dirs))\n",
      "replace": "    writeFileSync(args.dump, '')\n"
    },
    {
      "name": "tui-probe: the busy hint drifts from the footer",
      "source": "scripts/dev/tui-probe.ts",
      "find": "export const BUSY_MARKER = 'to interrupt'\n",
      "replace": "export const BUSY_MARKER = 'to cancel'\n"
    },
    {
      "name": "tui-probe: a send is idle before its turn starts",
      "source": "scripts/dev/tui-probe.ts",
      "find": "  const started = watch.sawBusy || now - w.startedAt >= graceMs\n",
      "replace": "  const started = true\n"
    },
    {
      "name": "tui-probe: idle without the pane settling",
      "source": "scripts/dev/tui-probe.ts",
      "find": "now - watch.stableSince >= SETTLE_MS",
      "replace": "true"
    },
    {
      "name": "tui-probe: the rule-map sync stays on",
      "source": "scripts/dev/tui-probe.ts",
      "find": "    'CLAUDIN_DISABLE_RULE_MAP_SYNC=1',\n",
      "replace": ""
    },
    {
      "name": "review 11-26 — tui-probe: send passes its text where tmux reads flags",
      "source": "scripts/dev/tui-probe.ts",
      "find": "  return ['send-keys', '-t', name, '-l', '--', text]\n",
      "replace": "  return ['send-keys', '-t', name, '-l', text]\n"
    },
    {
      "name": "review 11-26 — tui-probe: --until matches before the turn starts",
      "source": "scripts/dev/tui-probe.ts",
      "find": "    matched: started && until !== null && untilMatches(until, pane),\n",
      "replace": "    matched: until !== null && untilMatches(until, pane),\n"
    },
    {
      "name": "review 11-26 — session-census: an empty window exits 1 again",
      "source": "scripts/bench/tokens/session-census.ts",
      "find": "    return\n  }\n  const report = buildReport(walk(files, args.since))\n",
      "replace": "    process.exit(1)\n  }\n  const report = buildReport(walk(files, args.since))\n"
    }
  ]
}
