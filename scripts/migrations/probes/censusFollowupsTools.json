{
  "test": [
    "src/tools/shared/missingPath.test.ts",
    "src/tools/FileReadTool/overCapPage.test.ts",
    "src/tools/FileReadTool/autoOutlineOnElision.test.ts",
    "src/tools/GrepTool/GrepTool.census.test.ts",
    "src/agent/attachments/changedFile.test.ts"
  ],
  "source": "src/tools/shared/missingPath.ts",
  "probes": [
    {
      "name": "missingPath: test files count as siblings",
      "find": "(keepTests || !TEST_FILE_RE.test(entry))",
      "replace": "true"
    },
    {
      "name": "missingPath: a directory with the same name is not a guess",
      "find": "      if (basename(dir) === name) found.add(dir)\n",
      "replace": "      void dir\n"
    },
    {
      "name": "missingPath: more than three guesses are all named",
      "find": "  if (paths.length === 0 || paths.length > MAX_GUESSES) return undefined\n",
      "replace": "  if (paths.length === 0) return undefined\n"
    },
    {
      "name": "missingPath: the repo-wide name search is gone",
      "find": "    (await likelyPaths(fullPath, listFiles, readable))\n",
      "replace": "    undefined\n"
    },
    {
      "name": "missingPath: a path outside the cwd gets a guess",
      "find": "  if (!fullPath.startsWith(cwd + sep)) return undefined\n",
      "replace": ""
    },
    {
      "name": "missingPath: siblings are not tried first",
      "find": "  if (siblings.length > 0) return nameGuesses(siblings)\n",
      "replace": ""
    },
    {
      "name": "Grep: the missing path hint is not wired",
      "source": "src/tools/GrepTool/GrepTool.ts",
      "find": "await missingPathHint(expandPath(missing), context.getAppState().toolPermissionContext)",
      "replace": "''"
    },
    {
      "name": "Glob: the missing path hint is not wired",
      "source": "src/tools/GlobTool/GlobTool.ts",
      "find": "await missingPathHint(absolutePath, context.getAppState().toolPermissionContext)",
      "replace": "''"
    },
    {
      "name": "Read: the missing path hint is not wired",
      "source": "src/tools/FileReadTool/FileReadTool.ts",
      "find": "await missingPathHint(fullFilePath, context.getAppState().toolPermissionContext)",
      "replace": "''"
    },
    {
      "name": "Edit: the missing path hint is not wired",
      "source": "src/tools/FileEditTool/FileEditTool.ts",
      "find": "${await missingPathHint(fullFilePath, toolUseContext.getAppState().toolPermissionContext)}",
      "replace": ""
    },
    {
      "name": "review 11-26 — missingPath: the Read deny rules are not consulted",
      "find": "  const readable = (path: string) => matchingRuleForInput(path, permissions, 'read', 'deny') === null\n",
      "replace": "  const readable = (_path: string) => true\n"
    },
    {
      "name": "review 11-26 — missingPath: a hidden sibling is named",
      "find": "  const siblings = (await siblingsStartingWith(fullPath)).filter(readable)\n",
      "replace": "  const siblings = await siblingsStartingWith(fullPath)\n"
    },
    {
      "name": "review 11-26 — missingPath: a hidden same-name file is named",
      "find": "  return nameGuesses((await sameNameUnder(cwd, fullPath, listFiles)).filter(readable))\n",
      "replace": "  return nameGuesses(await sameNameUnder(cwd, fullPath, listFiles))\n"
    },
    {
      "name": "review 11-26 — changedFile: a page is diffed and adopted instead of marked",
      "source": "src/agent/attachments/changedFile.ts",
      "find": "    if (result.data.type === 'text' && result.data.file.note !== undefined) {\n",
      "replace": "    if (false) {\n"
    },
    {
      "name": "review 11-26 — readDispatch: the page is not counted again",
      "source": "src/tools/FileReadTool/readDispatch.ts",
      "find": "      candidate => validateContentTokens(candidate, ext, maxTokens),\n",
      "replace": "      async () => {},\n"
    },
    {
      "name": "review 11-26 — overCapPage: a page over the cap is not halved",
      "source": "src/tools/FileReadTool/overCapPage.ts",
      "find": "      if (!(e instanceof MaxFileReadTokenExceededError)) throw e\n",
      "replace": "      throw e\n"
    },
    {
      "name": "review 11-26 — overCapPage: a failing count is read as over the cap",
      "source": "src/tools/FileReadTool/overCapPage.ts",
      "find": "      if (!(e instanceof MaxFileReadTokenExceededError)) throw e\n",
      "replace": "      void e\n"
    },
    {
      "name": "review 11-26 — overCapPage: the note names no limit",
      "source": "src/tools/FileReadTool/overCapPage.ts",
      "find": "Read with offset=${last + 1} limit=${next} for the next page.",
      "replace": "Read with offset=${last + 1} for the next page."
    },
    {
      "name": "review 11-26 — overCapPage: the last page asks for more lines than are left",
      "source": "src/tools/FileReadTool/overCapPage.ts",
      "find": "  const next = Math.min(numLines, lines.length - numLines)\n",
      "replace": "  const next = numLines\n"
    },
    {
