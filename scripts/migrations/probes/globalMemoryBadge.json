{
  "test": [
    "src/agent/tools/collapseReadSearch.test.ts",
    "src/agent/ui/messages/CollapsedReadSearchContent.test.tsx",
    "src/agent/ui/messages/memoryRecallLine.test.ts"
  ],
  "source": "src/agent/tools/collapseReadSearch.ts",
  "probes": [
    {
      "name": "a global memory write is counted as global, not private",
      "find": "        if (isGlobalMemoryWriteOrEdit(toolInfo.name, toolInfo.input)) {\n",
      "replace": "        if (false) {\n"
    },
    {
      "name": "a search over the global dir is counted as global, not private",
      "find": "        if (isGlobalMemorySearch(toolInfo.input)) {\n",
      "replace": "        if (false) {\n"
    },
    {
      "name": "a global memory read is counted as global, not private",
      "find": "          if (isGlobalMemPath(filePath)) {\n",
      "replace": "          if (false) {\n"
    },
    {
      "name": "global reads leave the file count",
      "find": "      totalReadCount - memoryReadCount - globalMemReadCount - teamMemReadCount,\n",
      "replace": "      totalReadCount - memoryReadCount - teamMemReadCount,\n"
    },
    {
      "name": "global searches leave the pattern count",
      "find": "        group.globalMemorySearchCount -\n",
      "replace": ""
    },
    {
      "name": "global reads leave the file list",
      "find": "      !group.globalMemoryReadFilePaths.has(p) &&\n",
      "replace": ""
    },
    {
      "name": "the group carries the global read count",
      "find": "    result.globalMemoryReadCount = globalMemReadCount\n",
      "replace": ""
    },
    {
      "name": "the summary text includes global memory",
      "find": "    appendGlobalMemorySummaryParts(memoryCounts, isActive, parts)\n",
      "replace": ""
    },
    {
      "name": "a Grep over the bare global dir (no trailing slash) is a global search",
      "source": "src/memory/memdir/globalMemoryOps.ts",
      "find": "      getGlobalMemPath().replace(TRAILING_SEP_RE, '')\n",
      "replace": "      'never'\n"
    },
    {
      "name": "the summary names the search global",
      "source": "src/memory/memdir/globalMemoryOps.ts",
      "find": "    parts.push(`${verb} global memories`)\n",
      "replace": "    parts.push(`${verb} memories`)\n"
    },
    {
      "name": "the recall line names global memories global",
      "source": "src/agent/ui/messages/memoryRecallLine.ts",
      "find": "    parts.push(`${globalCount} global ${plural(globalCount, 'memory', 'memories')}`)\n",
      "replace": "    parts.push(`${globalCount} ${plural(globalCount, 'memory', 'memories')}`)\n"
    },
    {
      "name": "the recall line puts global ahead of private",
      "source": "src/agent/ui/messages/memoryRecallLine.ts",
      "find": "  if (globalCount > 0) {\n    parts.push(`${globalCount} global ${plural(globalCount, 'memory', 'memories')}`)\n  }\n  if (privateCount > 0) {\n    parts.push(`${privateCount} ${plural(privateCount, 'memory', 'memories')}`)\n  }\n",
      "replace": "  if (privateCount > 0) {\n    parts.push(`${privateCount} ${plural(privateCount, 'memory', 'memories')}`)\n  }\n  if (globalCount > 0) {\n    parts.push(`${globalCount} global ${plural(globalCount, 'memory', 'memories')}`)\n  }\n"
    },
    {
      "name": "the badge passes the global recall count to the Loaded line",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "formatMemoryRecallCounts(memoryReadCount, teamMemoryReadCount, globalMemoryReadCount)",
      "replace": "formatMemoryRecallCounts(memoryReadCount, teamMemoryReadCount)"
    },
    {
      "name": "a group of only global ops is not treated as empty",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": " || globalMemorySearchCount > 0 || globalMemoryReadCount > 0 || globalMemoryWriteCount > 0;\n",
      "replace": ";\n"
    },
    {
      "name": "the badge names a global search global",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "{`${verb_g} global memories`}",
      "replace": "{`${verb_g} memories`}"
    },
    {
      "name": "the badge names a global write global",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "<Text bold>{globalMemoryWriteCount}</Text> global{' '}",
      "replace": "<Text bold>{globalMemoryWriteCount}</Text>{' '}"
    },
    {
      "name": "a global memory search shows on the badge at all",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "  if (globalMemorySearchCount > 0) {\n",
      "replace": "  if (false) {\n"
    }
  ]
}
