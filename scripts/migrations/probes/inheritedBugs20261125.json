{
  "test": [
    "src/permissions/bashClassifier.adversarial.test.ts",
    "src/tools/BashTool/bashPermissions.promptRules.test.ts",
    "src/shared/fs/fileReadCache.test.ts",
    "src/terminal/input/dragDropPaths.test.ts",
    "src/terminal/hooks/usePasteHandler.test.ts",
    "src/shared/text/sliceAnsi.test.ts",
    "src/terminal/terminal.test.ts",
    "src/shared/data/memoize.test.ts",
    "src/mcp/client/fetchCapabilities.failure.test.ts",
    "src/shared/proc/execFileNoThrow.test.ts"
  ],
  "source": "src/permissions/bashClassifier.ts",
  "probes": [
    {
      "name": "prompt rules: a provider error reads as a non-match again",
      "find": "      reason: `classifier error: ${errorMessage(err)}`,\n      unavailable: true,\n",
      "replace": "      reason: `classifier error: ${errorMessage(err)}`,\n"
    },
    {
      "name": "prompt rules: an answer without a tool_use block reads as a non-match",
      "find": "        reason: 'classifier returned no tool_use block',\n        unavailable: true,\n",
      "replace": "        reason: 'classifier returned no tool_use block',\n"
    },
    {
      "name": "prompt rules: a malformed verdict reads as a non-match",
      "find": "        reason: 'classifier returned malformed response',\n        unavailable: true,\n",
      "replace": "        reason: 'classifier returned malformed response',\n"
    },
    {
      "name": "prompt rules: an out-of-range index reads as a non-match",
      "find": "        reason: `classifier returned an out-of-range index (${parsed.matchedIndex})`,\n        unavailable: true,\n",
      "replace": "        reason: `classifier returned an out-of-range index (${parsed.matchedIndex})`,\n"
    },
    {
      "name": "prompt rules: -1 stops being a clean non-match",
      "find": "parsed.matchedIndex === null || parsed.matchedIndex === -1",
      "replace": "parsed.matchedIndex === null"
    },
    {
      "name": "prompt rules: an unevaluated rule falls through to the literal allow",
      "source": "src/tools/BashTool/bashPermissions/decide.ts",
      "find": "        deferredAsk === null &&\n        (denyResult?.unavailable || askResult?.unavailable)\n",
      "replace": "        false\n"
    },
    {
      "name": "prompt rules: a matched ask returns before the literal denies",
      "source": "src/tools/BashTool/bashPermissions/decide.ts",
      "find": "        deferredAsk = {\n          behavior: 'ask',\n          message: createPermissionRequestMessage(BashTool.name),\n",
      "replace": "        return {\n          behavior: 'ask',\n          message: createPermissionRequestMessage(BashTool.name),\n"
    },
    {
      "name": "prompt rules: the deferred ask is never returned",
      "source": "src/tools/BashTool/bashPermissions/decide.ts",
      "find": "  if (deferredAsk !== null) {\n    return deferredAsk\n  }\n",
      "replace": "  if (deferredAsk !== null) void 0\n"
    },
    {
      "name": "prompt rules: an operator allow no longer yields to the deferred ask",
      "source": "src/tools/BashTool/bashPermissions/decide.ts",
      "find": "if (commandOperatorResult.behavior !== 'allow' || deferredAsk === null) {",
      "replace": "if (true) {"
    },
    {
      "name": "prompt rules: an exact allow passes the misparsing gate past a deferred ask",
      "source": "src/tools/BashTool/bashPermissions/decide.ts",
      "find": "if (exactMatchResult.behavior === 'allow' && deferredAsk === null) {",
      "replace": "if (exactMatchResult.behavior === 'allow') {"
    },
    {
      "name": "file cache: size stops invalidating",
      "source": "src/shared/fs/fileReadCache.ts",
      "find": "      cachedData.size === stats.size &&\n",
      "replace": ""
    },
    {
      "name": "file cache: ctime stops invalidating",
      "source": "src/shared/fs/fileReadCache.ts",
      "find": "      cachedData.ctime === stats.ctimeMs &&\n",
      "replace": ""
    },
    {
      "name": "file cache: inode stops invalidating",
      "source": "src/shared/fs/fileReadCache.ts",
      "find": "      cachedData.inode === stats.ino\n",
      "replace": "      true\n"
    },
    {
      "name": "drag and drop: the split ignores quoted paths again",
      "source": "src/terminal/input/dragDropPaths.ts",
      "find": "const PASTED_PATH_BOUNDARY = / (?=[\"']?(?:\\/|[A-Za-z]:\\\\))/",
      "replace": "const PASTED_PATH_BOUNDARY = / (?=\\/|[A-Za-z]:\\\\)/"
    },
    {
      "name": "drag and drop: the image paste keeps a private split",
      "source": "src/terminal/hooks/usePasteHandler.ts",
      "find": "    const hasImageFilePath = splitPastedPaths(input).some(line =>",
      "replace": "    const hasImageFilePath = input.split(/ (?=\\/|[A-Za-z]:\\\\)/).some(line =>"
    },
    {
      "name": "sliceAnsi: an empty slice closes styles it never opened",
      "source": "src/shared/text/sliceAnsi.ts",
      "find": "  if (!include) return { text: result, width }\n",
      "replace": ""
    },
    {
      "name": "sliceAnsi: fitEnd stops dropping a straddling glyph",
      "source": "src/shared/text/sliceAnsi.ts",
      "find": "      if (fitEnd && end !== undefined && width > 0 && position + width > end) {",
      "replace": "      if (false) {"
    },
    {
      "name": "sliceAnsi: displayCells goes back to stringWidth",
      "source": "src/shared/text/sliceAnsi.ts",
      "find": "    cells += tokenCells(token)",
      "replace": "    cells += token.type === 'char' ? stringWidth(token.value) : 0"
    },
    {
      "name": "terminal wrap: the slice may overshoot the width",
      "source": "src/terminal/terminal.ts",
      "find": "          fitEnd: true,\n",
      "replace": "          fitEnd: false,\n"
    },
    {
      "name": "terminal wrap: back to a fixed stride",
      "source": "src/terminal/terminal.ts",
      "find": "        position += chunk.width\n",
      "replace": "        position += wrapWidth\n"
    },
    {
      "name": "MCP: a failure stays memoized",
      "source": "src/shared/data/memoize.ts",
      "find": "        if (memoized.cache.get(key) === call) memoized.cache.delete(key)\n",
      "replace": ""
    },
    {
      "name": "MCP: the eviction loses its identity guard",
      "source": "src/shared/data/memoize.ts",
      "find": "        if (memoized.cache.get(key) === call) memoized.cache.delete(key)\n",
      "replace": "        memoized.cache.delete(key)\n"
    },
    {
      "name": "MCP: a failed tools/list answers [] inside the memo again",
      "source": "src/mcp/client/fetchCapabilities.ts",
      "find": "      logMCPError(client.name, `Failed to fetch tools: ${errorMessage(error)}`)\n      throw error\n",
      "replace": "      logMCPError(client.name, `Failed to fetch tools: ${errorMessage(error)}`)\n      return []\n"
    },
    {
      "name": "MCP: a failed resources/list answers [] inside the memo again",
      "source": "src/mcp/client/fetchCapabilities.ts",
      "find": "        `Failed to fetch resources: ${errorMessage(error)}`,\n      )\n      throw error\n",
      "replace": "        `Failed to fetch resources: ${errorMessage(error)}`,\n      )\n      return []\n"
    },
    {
      "name": "MCP: a failed prompts/list answers [] inside the memo again",
      "source": "src/mcp/client/fetchCapabilities.ts",
      "find": "        `Failed to fetch commands: ${errorMessage(error)}`,\n      )\n      throw error\n",
      "replace": "        `Failed to fetch commands: ${errorMessage(error)}`,\n      )\n      return []\n"
    },
    {
      "name": "execFileNoThrow: the timeout only kills and waits for close",
      "source": "src/shared/proc/execFileNoThrow.ts",
      "find": "            child.kill()\n            finish({\n              stdout: finalPreserveOutput ? stdout : '',\n              stderr: finalPreserveOutput ? stderr : '',\n              code: 1,\n              error: `Command timed out after ${finalTimeout}ms`,\n            })\n",
      "replace": "            child.kill()\n"
    }
  ]
}
