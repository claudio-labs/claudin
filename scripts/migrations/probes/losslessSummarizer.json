{
  "test": [
    "src/agent/tools/toolResultSummarizer.lossless.test.ts",
    "src/agent/tools/toolResultSummarizer.test.ts",
    "src/agent/tools/toolResultSummarizer.integration.test.ts",
    "src/agent/tools/toolResultStorage.test.ts",
    "src/agent/context/tokensSaved.test.ts"
  ],
  "source": "src/agent/tools/toolResultStorage.ts",
  "probes": [
    {
      "name": "lossless: =0 no longer brings the cut back",
      "source": "src/agent/tools/toolResultSummarizer/thresholds.ts",
      "find": "  return !isEnvDefinedFalsy(process.env.CLAUDIN_TOOL_RESULT_LOSSLESS)\n",
      "replace": "  return true\n"
    },
    {
      "name": "lossless: off by default",
      "source": "src/agent/tools/toolResultSummarizer/thresholds.ts",
      "find": "  return !isEnvDefinedFalsy(process.env.CLAUDIN_TOOL_RESULT_LOSSLESS)\n",
      "replace": "  return false\n"
    },
    {
      "name": "line: a result past it ships whole anyway",
      "find": "  return content == null || contentSize(content) <= persistenceThreshold ? compacted : null\n",
      "replace": "  return compacted\n"
    },
    {
      "name": "line: a result exactly at it is cut",
      "find": "  return content == null || contentSize(content) <= persistenceThreshold ? compacted : null\n",
      "replace": "  return content == null || contentSize(content) < persistenceThreshold ? compacted : null\n"
    },
    {
      "name": "line: storage never asks, so everything is cut",
      "find": "    : keepWholeUnderLine(toolResultBlock, toolName, persistenceThreshold)\n",
      "replace": "    : null\n"
    },
    {
      "name": "line: the regroup is skipped, so a Grep ships raw",
      "find": "  const compacted = maybeCompactToolResult(toolResultBlock, toolName)\n",
      "replace": "  const compacted = toolResultBlock\n"
    },
    {
      "name": "regroup: the summarizer kill switch is ignored",
      "source": "src/agent/tools/toolResultSummarizer.ts",
      "find": "    if (isEnvTruthy(process.env.CLAUDIN_DISABLE_TOOL_RESULT_SUMMARIZER)) return block\n",
      "replace": "\n"
    },
    {
      "name": "regroup: a compacted envelope is regrouped again",
      "source": "src/agent/tools/toolResultSummarizer/markers.ts",
      "find": "    text.startsWith(TOOL_RESULT_COMPACTED_TAG) ||\n",
      "replace": "\n"
    },
    {
      "name": "glob regroup: an indented path is grouped anyway",
      "source": "src/agent/tools/toolResultSummarizer/glob.ts",
      "find": "  if (lines.some(l => l.startsWith(' '))) return null\n",
      "replace": "\n"
    },
    {
      "name": "glob regroup: a run the header does not pay for is grouped",
      "source": "src/agent/tools/toolResultSummarizer/glob.ts",
      "find": "    if (dir !== '' && (end - i) * (dir.length - GLOB_INDENT.length) > dir.length + 1) {\n",
      "replace": "    if (dir !== '') {\n"
    },
    {
      "name": "glob regroup: the path count goes",
      "source": "src/agent/tools/toolResultSummarizer/glob.ts",
      "find": ", envelopeAttrs: { paths: String(paths) }",
      "replace": ""
    },
    {
      "name": "grep regroup: a file with no match line of its own gets a header",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "    if (split?.isMatch && split.file !== GREP_NO_PATH) matched.add(split.file)\n",
      "replace": "    if (split && split.file !== GREP_NO_PATH) matched.add(split.file)\n"
    },
    {
      "name": "grep regroup: a run its header does not pay for is grouped",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "    if (count * (file.length + 1) > file.length + GREP_HEADER_OVERHEAD) {\n",
      "replace": "    if (count > 0) {\n"
    },
    {
      "name": "grep regroup: a line naming no file does not end the run",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "      if (fileOf(j) !== file) break\n",
      "replace": "      if (fileOf(j) !== file) continue\n"
    },
    {
      "name": "grep regroup: the -- between blocks is dropped",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "        if (lines[k] === GREP_BLOCK_SEPARATOR || !split) out.push(lines[k]!)\n",
      "replace": "        if (lines[k] === GREP_BLOCK_SEPARATOR || !split) continue\n"
    },
    {
      "name": "grep regroup: the path stays on every line",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "        else out.push(`${split.raw}${split.isMatch ? ':' : '-'}${split.body}`)\n",
      "replace": "        else out.push(`${split.file}${split.isMatch ? ':' : '-'}${split.raw}${split.isMatch ? ':' : '-'}${split.body}`)\n"
    },
    {
      "name": "grep regroup: an ambiguous leftover line is shipped anyway",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "      if (line !== GREP_BLOCK_SEPARATOR && (GREP_HEADER_RE.test(line) || GREP_NUMBERED_RE.test(line))) return null\n",
      "replace": "\n"
    },
    {
      "name": "grep regroup: an inline line that reads as numbered is shipped anyway",
      "source": "src/agent/tools/toolResultSummarizer/grep.ts",
      "find": "        if (line !== GREP_BLOCK_SEPARATOR && GREP_NUMBERED_RE.test(line)) return null\n",
      "replace": "\n"
    }
  ]
}
