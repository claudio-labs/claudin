      "source": "src/skills/loadSkillsDir.ts",
      "find": "    allowedTools: isRemote ? [] : allowedTools,\n",
      "replace": "    allowedTools,\n"
    },
    {
      "name": "permissions: an MCP skill's hooks are kept",
      "source": "src/skills/loadSkillsDir.ts",
      "find": "    hooks: isRemote ? undefined : hooks,\n",
      "replace": "    hooks,\n"
    },
    {
