      "source": "src/mcp/useManageMCPConnections.ts",
      "find": "                    ...client,\n                    commands: [...mcpPrompts, ...mcpSkills],\n",
      "replace": "                    ...client,\n                    commands: [...mcpPrompts],\n"
    },
    {
      "name": "hook: a resources/list_changed answers the skills from the memo",
      "source": "src/mcp/useManageMCPConnections.ts",
      "find": "                  fetchSkillsForClient.cache.delete(client.name)\n",
      "replace": ""
