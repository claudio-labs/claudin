{
  "test": "src/mcp/auth.test.ts",
  "source": "src/mcp/auth/callbackParams.ts",
  "probes": [
    {
      "name": "state is compared before any error parameter is honoured",
      "find": "  if (state !== oauthState) {\n    return { type: 'state_mismatch' }\n  }",
      "replace": "  if (false as boolean) {\n    return { type: 'state_mismatch' }\n  }"
    },
    {
      "name": "a repeated parameter takes the first NON-EMPTY value, not index 0",
      "find": "  if (Array.isArray(value)) return value.find(item => item !== '')",
      "replace": "  if (Array.isArray(value)) return value[0]"
    },
    {
      "name": "an empty parameter value is undefined, not the empty string",
      "find": "  return value ? value : undefined",
      "replace": "  return value ?? undefined"
    },
    {
      "name": "a sensitive parameter's value is replaced, not just rewritten",
      "find": "    if (parsed.searchParams.has(name)) parsed.searchParams.set(name, REDACTION)",
      "replace": "    if (parsed.searchParams.has(name)) parsed.searchParams.set(name, parsed.searchParams.get(name) ?? '')"
    },
    {
      "name": "redaction only touches parameters the URL actually carried",
      "find": "    if (parsed.searchParams.has(name)) parsed.searchParams.set(name, REDACTION)",
      "replace": "    if (true as boolean) parsed.searchParams.set(name, REDACTION)"
    },
    {
      "name": "a string that is not a URL comes back unchanged",
      "find": "  } catch {\n    return url\n  }",
      "replace": "  } catch {\n    return ''\n  }"
    },
    {
      "name": "'code' is in the sensitive-parameter list",
      "find": "  'code_verifier',\n  'code',\n]",
      "replace": "  'code_verifier',\n]"
    },
    {
      "name": "'state' is in the sensitive-parameter list",
      "find": "const LOG_REDACTED_QUERY_PARAMS: readonly string[] = [\n  'state',",
      "replace": "const LOG_REDACTED_QUERY_PARAMS: readonly string[] = ["
    },
    {
      "name": "a non-2xx response is returned untouched, by identity",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  if (!response.ok) return response",
      "replace": "  if (false as boolean) return response"
    },
    {
      "name": "a body parsing as tokens wins over a body parsing as an error",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  if (OAuthTokensSchema.safeParse(body).success) return undefined",
      "replace": "  if (false as boolean) return undefined"
    },
    {
      "name": "a body that is not JSON does not throw out of the normalizer",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  try {\n    return jsonParse(text)\n  } catch {\n    return undefined\n  }",
      "replace": "  return jsonParse(text)"
    },
    {
      "name": "a JSON body of an unrelated shape is left alone",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  if (!parsed.success) return undefined",
      "replace": "  if (false as boolean) return undefined"
    },
    {
      "name": "the non-standard alias set is consulted at all",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  if (VENDOR_INVALID_GRANT_CODES.has(error)) {",
      "replace": "  if (false as boolean) {"
    },
    {
      "name": "'invalid_refresh_token' is one of the aliases",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  'invalid_refresh_token',\n  'expired_refresh_token',",
      "replace": "  'expired_refresh_token',"
    },
    {
      "name": "'expired_refresh_token' is one of the aliases",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  'expired_refresh_token',\n  'token_expired',",
      "replace": "  'token_expired',"
    },
    {
      "name": "'token_expired' is one of the aliases",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  'token_expired',\n])",
      "replace": "])"
    },
    {
      "name": "an error code outside the alias set keeps its own code",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "  return { error, error_description, error_uri }",
      "replace": "  return { error: 'invalid_grant' }"
    },
    {
      "name": "a normalized alias carries a description naming the original code",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "        `Server returned non-standard error code: ${error}`,",
      "replace": "        '',"
    },
    {
      "name": "the server's own error_description survives normalization",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "        error_description ??\n        `Server returned non-standard error code: ${error}`,",
      "replace": "        `Server returned non-standard error code: ${error}`,"
    },
    {
      "name": "a normalized error body is rewritten to a 400",
      "source": "src/mcp/auth/oauthErrors.ts",
      "find": "    status: 400,\n    statusText: 'Bad Request',",
      "replace": "    status: 200,\n    statusText: 'Bad Request',"
    },
    {
      "name": "the server URL is part of the credential key",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "    url: serverConfig.url,\n    headers: serverConfig.headers ?? {},",
      "replace": "    headers: serverConfig.headers ?? {},"
    },
    {
      "name": "the configured headers are part of the credential key",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "    headers: serverConfig.headers ?? {},\n  })",
      "replace": "  })"
    },
    {
      "name": "absent headers are normalized to {} before hashing",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "    headers: serverConfig.headers ?? {},",
      "replace": "    headers: serverConfig.headers,"
    },
    {
      "name": "the transport type is part of the credential key",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "    type: serverConfig.type,\n    url: serverConfig.url,",
      "replace": "    url: serverConfig.url,"
    },
    {
      "name": "the server name is part of the credential key",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "  return `${serverName}|${digest.slice(0, DIGEST_HEX_CHARS)}`",
      "replace": "  return digest.slice(0, DIGEST_HEX_CHARS)"
    },
    {
      "name": "the config digest is 16 hex characters",
      "source": "src/mcp/auth/serverKey.ts",
      "find": "const DIGEST_HEX_CHARS = 16",
      "replace": "const DIGEST_HEX_CHARS = 8"
    },
    {
      "name": "AuthenticationCancelledError carries its own .name",
      "source": "src/mcp/auth/oauthFlow.ts",
      "find": "    this.name = 'AuthenticationCancelledError'",
      "replace": "    this.name = 'Error'"
    },
    {
      "name": "AuthenticationCancelledError carries its own message",
      "source": "src/mcp/auth/oauthFlow.ts",
      "find": "    super('Authentication was cancelled')",
      "replace": "    super('cancelled')"
    },
    {
      "name": "SURFACE PIN: a re-export missing from the barrel is caught",
      "source": "src/mcp/auth.ts",
      "find": "  clearMcpClientConfig,\n",
      "replace": ""
    },
    {
      "name": "SURFACE PIN: a changed call signature is caught",
      "source": "src/mcp/auth/oauthFlow.ts",
      "find": "  abortSignal?: AbortSignal,",
      "replace": "  abortSignal: AbortSignal | undefined = undefined,"
    }
  ]
}
