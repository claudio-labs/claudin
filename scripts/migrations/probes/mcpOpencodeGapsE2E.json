{
  "build": true,
  "test": ["src/commands/mcp/loginCommand.e2e.test.ts"],
  "source": "src/commands/mcp/loginCommand.ts",
  "probes": [
    {
      "name": "review: mcp login off a terminal exits before the callback again",
      "find": "  const keepAlive = setInterval(() => {}, 60_000)\n",
      "replace": "  const keepAlive = undefined\n"
    },
    {
      "name": "review: a failed login or logout exits 0",
      "find": "  if (ok) cliOk(message)\n  else cliError(message)\n",
      "replace": "  cliOk(message)\n"
    }
  ]
}
