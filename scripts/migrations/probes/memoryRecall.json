{
  "test": [
    "src/agent/tools/collapseReadSearch.test.ts",
    "src/agent/ui/messages/CollapsedReadSearchContent.test.tsx",
    "src/agent/ui/messages/memoryRecallLine.test.ts"
  ],
  "source": "src/agent/ui/messages/memoryRecallLine.ts",
  "comment": "The \"Loaded …\" line of a collapsed read/search group: formatMemoryRecallCounts turns CollapsedReadSearchGroup.memoryOps into one part per scope, and CollapsedReadSearchContent renders it. The count phrase itself (\"2 team memories\") is countMemories in memoryScopes.ts, outside this spec's sources. The badge is memoryScopeBadge.json.",
  "probes": [
    {
      "name": "nothing recalled returns undefined, so no empty Loaded line renders",
      "find": "  return parts.length > 0 ? parts.join(', ') : undefined\n",
      "replace": "  return parts.join(', ')\n"
    },
    {
      "name": "a scope with no recall adds no part",
      "find": "    if (read > 0) {\n",
      "replace": "    if (read >= 0) {\n"
    },
    {
      "name": "the recall line goes global, private, team",
      "find": "  for (const scope of MEMORY_SCOPES) {\n",
      "replace": "  for (const scope of [...MEMORY_SCOPES].reverse()) {\n"
    },
    {
      "name": "each recall is labelled with its own scope",
      "find": "      parts.push(countMemories(scope, read))\n",
      "replace": "      parts.push(countMemories('private', read))\n"
    },
    {
      "name": "the collapsed group renders the Loaded line at all",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "      {recalledCounts !== undefined && <Text dimColor>\n          {'  ⎿  '}Loaded <Text bold>{recalledCounts}</Text>\n          {!hasBadgeParts && <>\n              {' '}\n              <CtrlOToExpand />\n            </>}\n        </Text>}\n",
      "replace": ""
    },
    {
      "name": "a recall-only group drops the empty badge row instead of printing it",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "  const hasBadgeParts = nonMemParts.length > 0 || memParts.length > 0;\n",
      "replace": "  const hasBadgeParts = true;\n"
    },
    {
      "name": "the collapsed group hands its memoryOps to the Loaded line",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "  const recalledCounts = formatMemoryRecallCounts(memoryOps);\n",
      "replace": "  const recalledCounts = formatMemoryRecallCounts(undefined);\n"
    },
    {
      "name": "the render gate counts recalls, so a recall-only group is not dropped",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "(ops.search > 0 || ops.read > 0 || ops.write > 0);\n",
      "replace": "(ops.search > 0 || ops.write > 0);\n"
    }
  ]
}
