      "replace": ""
    },
    {
      "name": "a live async agent runs",
      "source": "src/agent/ui/ToolStatusIcon.tsx",
      "find": "  if (isAsync) return 'running';\n",
      "replace": ""
    },
    {
      "name": "an error wins over an unresolved call",
      "source": "src/agent/ui/ToolStatusIcon.tsx",
      "find": "  if (isError) return 'error';\n",
      "replace": ""
