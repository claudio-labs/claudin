  "source": "src/terminal/terminalFont.ts",
  "probes": [
    {
      "name": "tmux markers name the outer terminal",
      "find": "  if (NERD_FONT_TERMINAL_MARKERS.some(name => env[name])) return true\n",
      "replace": ""
    },
    {
      "name": "iTerm2's LC_TERMINAL counts",
      "find": "  return env.LC_TERMINAL === 'iTerm2'",
      "replace": "  return false"
    },
    {
      "name": "the markers count only behind tmux or screen",
      "comment": "another emulator started from a Ghostty/kitty/WezTerm shell inherits them",
      "find": "  if (!isMultiplexer(env)) return false\n",
      "replace": ""
    },
    {
      "name": "$TMUX alone says tmux is in front",
      "find": "  if (env.TMUX) return true\n",
      "replace": ""
    },
    {
      "name": "screen counts as a multiplexer",
      "find": "  return term.startsWith('tmux') || term.startsWith('screen')",
      "replace": "  return term.startsWith('tmux')"
    },
    {
      "name": "a render can say no to the icons",
      "find": "  return useContext(NerdFontGlyphsContext) ?? hasNerdFontGlyphs()",
      "replace": "  return hasNerdFontGlyphs()"
    },
    {
      "name": "the plain-text export asks for no icons",
      "source": "src/platform/exportRenderer.tsx",
      "find": "    plainGlyphs: true\n",
      "replace": "    plainGlyphs: false\n"
    },
    {
      "name": "the scrollback dump keeps the icons",
      "source": "src/platform/exportRenderer.tsx",
      "find": "value={plainGlyphs ? false : undefined}",
      "replace": "value={false}"
    },
    {
      "name": "a tool row follows the render's answer",
      "source": "src/agent/ui/messages/AssistantToolUseMessage.tsx",
      "find": "rowIcons: getToolRowIcons(tool, data, nerdFont)",
      "replace": "rowIcons: getToolRowIcons(tool, data)"
    },
    {
      "name": "a ctrl+o detail row follows the render's answer",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "const rowIcons = getToolRowIcons(tool, input, nerdFont);",
      "replace": "const rowIcons = getToolRowIcons(tool, input);"
    },
    {
      "name": "the collapsed badge follows the render's answer",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "const partIcons = getCollapsedPartIcons(nerdFont);",
      "replace": "const partIcons = getCollapsedPartIcons();"
    },
    {
      "name": "the /config setting turns icons on",
      "find": "  if (setting === 'on') return true\n",
      "replace": ""
    },
    {
      "name": "the /config setting turns icons off",
      "find": "  if (setting === 'off') return false\n",
      "replace": ""
    },
    {
      "name": "the env override beats the setting",
      "find": "  if (isEnvTruthy(override)) return true\n  if (isEnvDefinedFalsy(override)) return false\n  if (setting === 'on')",
      "replace": "  if (setting === 'on')"
    },
    {
      "name": "the terminal heuristic is memoized",
      "find": "  terminalDetection ??= detectNerdFontTerminal(process.env)",
      "replace": "  terminalDetection = detectNerdFontTerminal(process.env)"
    },
    {
      "name": "the setting is read from global config",
      "find": "    getGlobalConfig().nerdFontIcons,",
      "replace": "    undefined,"
    },
    {
      "name": "/config offers auto/on/off",
      "source": "src/platform/settings/ui/Config.tsx",
      "find": "    options: [...NERD_FONT_ICONS_OPTIONS],",
      "replace": "    options: ['auto'],"
    },
    {
      "name": "the /config row is grouped under Terminal",
      "source": "src/platform/settings/ui/configGroups.ts",
      "find": "      'nerdFontIcons',\n",
      "replace": ""
    },
    {
      "name": "the @-menu reads the gate when it renders",
      "source": "src/terminal/prompt-input/PromptInputFooterSuggestions.tsx",
      "find": "  const nerd = hasNerdFontGlyphs()",
      "replace": "  const nerd = true"
