      "name": "a dotless row shows its icon as done",
      "source": "src/agent/ui/messages/AssistantToolUseMessage.tsx",
      "find": "    }) : \"done\"} /> : shouldShowDot",
      "replace": "    }) : \"error\"} /> : shouldShowDot"
    },
    {
      "name": "the row's error reaches the icon",
      "source": "src/agent/ui/messages/AssistantToolUseMessage.tsx",
      "find": "      isError: lookups.erroredToolUseIDs.has(param.id),\n",
      "replace": "      isError: false,\n"
    },
    {
      "name": "the file icon renders inside the parens",
      "source": "src/agent/ui/messages/AssistantToolUseMessage.tsx",
      "find": "{rowIcons.fileIcon && <Text color={rowIcons.fileIcon.color}>{rowIcons.fileIcon.glyph} </Text>}",
      "replace": ""
    },
