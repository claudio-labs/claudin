      "source": "src/agent/ui/messages/toolRowIcons.ts",
      "find": "  [NOTEBOOK_EDIT_TOOL_NAME]: 'notebook_path',",
      "replace": "  [NOTEBOOK_EDIT_TOOL_NAME]: 'file_path',"
    },
    {
      "name": "an empty path gets no file icon",
      "source": "src/agent/ui/messages/toolRowIcons.ts",
      "find": "  if (typeof path !== 'string' || path === '') return { toolIcon }",
      "replace": "  if (typeof path !== 'string') return { toolIcon }"
    },
