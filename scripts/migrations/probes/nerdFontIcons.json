{
  "test": [
    "src/terminal/terminalFont.test.ts",
    "src/platform/settings/ui/configNerdFontRow.test.ts",
    "src/platform/settings/ui/configGroups.test.ts",
    "src/terminal/prompt-input/PromptInputFooterSuggestions.test.tsx",
    "src/agent/ui/messages/toolRowIcons.test.ts",
    "src/agent/ui/messages/AssistantToolUseMessage.icons.test.tsx",
    "src/agent/ui/messages/CollapsedReadSearchContent.test.tsx",
