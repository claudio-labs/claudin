      "find": "        {partIcon(kind)}{isFirst ? verb[0]!.toUpperCase() + verb.slice(1) : verb} {body}\n      </Text>);\n  }\n  if (isFullscreenEnvEnabled() && message.commits?.length) {",
      "replace": "        {isFirst ? verb[0]!.toUpperCase() + verb.slice(1) : verb} {body}\n      </Text>);\n  }\n  if (isFullscreenEnvEnabled() && message.commits?.length) {"
    },
    {
      "name": "a memory part leads with the brain",
      "source": "src/agent/ui/messages/CollapsedReadSearchContent.tsx",
      "find": "        {partIcon('memory')}",
      "replace": ""
