{
  "test": [
    "src/agent/ui/collapseNestedMemory.test.ts",
    "src/agent/ui/messages/AttachmentMessage.nestedMemoryBatch.test.tsx"
  ],
  "source": "src/agent/ui/collapseNestedMemory.ts",
  "probes": [
    {
      "name": "a memory-dir file is named by its scope, the way a Read of one is",
      "find": "        one: `${scope} memory`,\n        many: `${scope} memories`,\n",
      "replace": "        one: 'memory',\n        many: 'memories',\n"
    },
    {
      "name": "the scopes come out in MEMORY_SCOPES order, not arrival order",
      "find": "        rank: FIRST_SCOPE_RANK + MEMORY_SCOPES.indexOf(scope),\n",
      "replace": "        rank: FIRST_SCOPE_RANK,\n"
    },
    {
      "name": "a category subdirectory names the category on the line",
      "find": "      one: `${scope} ${category.noun} memory`,\n      many: `${scope} ${category.noun} memories`,\n",
      "replace": "      one: `${scope} memory`,\n      many: `${scope} memories`,\n"
    },
    {
      "name": "only a scope with subdirectories has categories",
      "find": "    const category = MEMORY_SCOPE_SPECS[scope].hasSubdirectories\n",
      "replace": "    const category = true\n"
    },
    {
      "name": "the category is the file's PARENT directory, nothing higher",
      "source": "src/memory/memdir/memoryTypes.ts",
      "find": "  const dir = basename(dirname(filePath))\n",
      "replace": "  const dir = basename(dirname(dirname(filePath)))\n"
    },
    {
      "name": "clauses come out in rank order, not arrival order",
      "find": "    .sort((a, b) => a.rank - b.rank)\n",
      "replace": ""
    },
    {
      "name": "a count of one is singular",
      "find": "    .map(group => `${group.count} ${plural(group.count, group.one, group.many)}`)\n",
      "replace": "    .map(group => `${group.count} ${group.many}`)\n"
    },
    {
      "name": "the collapse carries each file's memory type into the batch",
      "find": "    type: attachment.content.type,\n",
      "replace": "    type: 'Project',\n"
    },
    {
      "name": "the batch arm renders the label, not a bare file count",
      "source": "src/agent/ui/messages/AttachmentMessage.tsx",
      "find": "            <Text bold>{nestedMemoryBatchLabel(files)}</Text>\n",
      "replace": "            <Text bold>{files.length} memory files</Text>\n"
    }
  ]
}
