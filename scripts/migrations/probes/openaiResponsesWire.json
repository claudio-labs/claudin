      "replace": "  }"
    },
    {
      "name": "messages are replayed under their ids on the Responses API",
      "find": "    replayMessageIds: onCodexBackend,\n",
      "replace": "    replayMessageIds: true,\n"
    },
    {
      "name": "OpenAI gets no prompt cache key",
      "find": "    ...(responsesApi && isOfficialOpenAIUrl(options.request.baseUrl) && {",
