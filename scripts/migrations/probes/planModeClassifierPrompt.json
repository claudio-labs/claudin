{
  "test": "src/permissions/yoloClassifier.planMode.test.ts",
  "source": "src/permissions/yoloClassifier/prompts.ts",
  "probes": [
    {
      "name": "plan-mode deny bullets are appended",
      "find": "  { key: 'soft_deny', tag: 'user_deny_rules_to_replace', planRules: PLAN_MODE_DENY_RULES },",
      "replace": "  { key: 'soft_deny', tag: 'user_deny_rules_to_replace', planRules: [] },"
    },
    {
      "name": "plan-mode allow bullets are appended",
      "find": "  { key: 'allow', tag: 'user_allow_rules_to_replace', planRules: PLAN_MODE_ALLOW_RULES },",
      "replace": "  { key: 'allow', tag: 'user_allow_rules_to_replace', planRules: [] },"
    },
    {
      "name": "bullets go only to plan mode",
      "find": "  const inPlanMode = context.mode === 'plan'\n",
      "replace": "  const inPlanMode = true\n"
    }
  ]
}
