      "replace": "    case \"git\":\n"
    },
    {
      "name": "lane: a substitution is a read",
      "find": "  if (SUBSTITUTION_RE.test(command)) return false;\n",
      "replace": "\n"
    },
    {
      "name": "lane: an output redirect is a read",
      "find": "  if (!walked || walked.hasOutputRedirection) return false;\n",
