      "find": "      best = {\n        kind: 'clip',\n        lane: 'rss',\n",
      "replace": "      best = {\n        selectAll: input.windowClipAll ? true : undefined,\n        kind: 'clip',\n        lane: 'rss',\n"
    }
  ]
