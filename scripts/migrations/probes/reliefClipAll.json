      "find": "  return v !== '0' && v !== 'false'\n",
      "replace": "  return false\n"
    },
    {
      "name": "the shell passes the switch to the decision",
      "source": "src/agent/compact/microCompact.ts",
      "find": "    windowClipAll: isReliefClipAllEnabled(),\n",
      "replace": "    windowClipAll: false,\n"
    },
    {
