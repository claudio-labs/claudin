{
  "test": "src/skills/bundledSkills.characterization.test.ts",
  "source": "src/skills/bundledSkills.ts",
  "probes": [
    {
      "name": "root: the random segment is gone",
      "source": "src/skills/bundledSkillsRoot.ts",
      "find": "    const nonce = randomBytes(16).toString('hex')\n",
      "replace": "    const nonce = 'fixed'\n"
    },
    {
      "name": "root: not stable for the process",
      "source": "src/skills/bundledSkillsRoot.ts",
      "find": "export const getBundledSkillsRoot = memoize(\n",
      "replace": "export const getBundledSkillsRoot = ((f: () => string) => f)(\n"
    },
    {
      "name": "root: not scoped by version",
      "source": "src/skills/bundledSkillsRoot.ts",
      "find": "join(getClaudeTempDir(), 'bundled-skills', MACRO.VERSION, nonce)",
      "replace": "join(getClaudeTempDir(), 'bundled-skills', nonce)"
    },
    {
      "name": "extract dir: not the root joined with the name",
      "find": "  return join(getBundledSkillsRoot(), skillName)\n",
      "replace": "  return join(getBundledSkillsRoot(), 'skills', skillName)\n"
    },
    {
      "name": "command: allowedTools no longer defaults to []",
      "find": "    allowedTools: definition.allowedTools ?? [],\n",
      "replace": "    allowedTools: definition.allowedTools,\n"
    },
    {
      "name": "command: model invocation disabled by default",
      "find": "    disableModelInvocation: definition.disableModelInvocation ?? false,\n",
      "replace": "    disableModelInvocation: definition.disableModelInvocation ?? true,\n"
    },
    {
      "name": "command: not user-invocable by default",
      "find": "    userInvocable: definition.userInvocable ?? true,\n",
      "replace": "    userInvocable: definition.userInvocable ?? false,\n"
    },
    {
      "name": "command: a non-invocable skill is not hidden",
      "find": "    isHidden: !(definition.userInvocable ?? true),\n",
      "replace": "    isHidden: false,\n"
    },
    {
      "name": "command: wrong source",
      "find": "    source: 'bundled',\n",
      "replace": "    source: 'builtin',\n"
    },
    {
      "name": "command: wrong progress message",
      "find": "    progressMessage: 'running',\n",
      "replace": "    progressMessage: 'loading',\n"
    },
    {
      "name": "command: description not marked user-specified",
      "find": "    hasUserSpecifiedDescription: true,\n",
      "replace": "    hasUserSpecifiedDescription: false,\n"
    },
    {
      "name": "command: aliases dropped",
      "find": "    aliases: definition.aliases,\n",
      "replace": "    aliases: undefined,\n"
    },
    {
      "name": "command: agent dropped",
      "find": "    agent: definition.agent,\n",
      "replace": "    agent: undefined,\n"
    },
    {
      "name": "command: isEnabled dropped",
      "find": "    isEnabled: definition.isEnabled,\n",
      "replace": "    isEnabled: undefined,\n"
    },
    {
      "name": "command: hooks dropped",
      "find": "    hooks: definition.hooks,\n",
      "replace": "    hooks: undefined,\n"
    },
    {
      "name": "command: context dropped",
      "find": "    context: definition.context,\n",
      "replace": "    context: undefined,\n"
    },
    {
      "name": "command: model dropped",
      "find": "    model: definition.model,\n",
      "replace": "    model: undefined,\n"
    },
    {
      "name": "registry: hands out the live array",
      "find": "  return [...bundledSkills]\n",
      "replace": "  return bundledSkills\n"
    },
    {
      "name": "registry: clear does nothing",
      "find": "  bundledSkills.length = 0\n",
      "replace": "  void bundledSkills\n"
    },
    {
      "name": "files: an empty map still gets a skill root",
      "find": "  if (files && Object.keys(files).length > 0) {\n",
      "replace": "  if (files) {\n"
    },
    {
      "name": "files: skillRoot not set",
      "find": "    skillRoot = getBundledSkillExtractDir(definition.name)\n",
      "replace": "    skillRoot = undefined\n"
    },
    {
      "name": "files: extracted on every call",
      "find": "      extractionPromise ??= extractBundledSkillFiles(definition.name, files)\n",
      "replace": "      extractionPromise = extractBundledSkillFiles(definition.name, files)\n"
    },
    {
      "name": "files: arguments not passed through",
      "find": "      const blocks = await inner(args, ctx)\n",
      "replace": "      const blocks = await inner('', ctx)\n"
    },
    {
      "name": "files: a failed extraction drops the prompt",
      "find": "      if (extractedDir === null) return blocks\n",
      "replace": "      if (extractedDir === null) return []\n"
    },
    {
      "name": "files: a failed extraction throws",
      "find": "    )\n    return null\n",
      "replace": "    )\n    throw e\n"
    },
    {
      "name": "files: wrong announcement",
      "find": "  const prefix = `Base directory for this skill: ${baseDir}\\n\\n`\n",
      "replace": "  const prefix = `Skill directory: ${baseDir}\\n\\n`\n"
    },
    {
      "name": "files: never merged into a leading text block",
      "find": "  if (blocks.length > 0 && blocks[0]!.type === 'text') {\n",
      "replace": "  if (false) {\n"
    },
    {
      "name": "files: an absolute key is accepted",
      "find": "    isAbsolute(normalized) ||\n",
      "replace": "    false ||\n"
    },
    {
      "name": "files: traversal no longer refused",
      "find": "    throw new Error(`bundled skill file path escapes skill dir: ${relPath}`)\n",
      "replace": "    void relPath\n"
    },
    {
      "name": "files: an existing file is overwritten",
      "find": "      fsConstants.O_EXCL |\n",
      "replace": "      fsConstants.O_TRUNC |\n"
    },
    {
      "name": "files: world-readable files",
      "find": "  const fh = await open(p, SAFE_WRITE_FLAGS, 0o600)\n",
      "replace": "  const fh = await open(p, SAFE_WRITE_FLAGS, 0o644)\n"
    },
    {
      "name": "files: world-readable directories",
      "find": "      await mkdir(parent, { recursive: true, mode: 0o700 })\n",
      "replace": "      await mkdir(parent, { recursive: true, mode: 0o755 })\n"
    }
  ]
}
