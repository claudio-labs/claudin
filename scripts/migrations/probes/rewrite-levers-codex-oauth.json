{
  "test": [
    "src/providers/oauth/codexCredentials.characterization.test.ts",
    "src/providers/oauth/codexOAuthShared.characterization.test.ts",
    "src/providers/oauth/codexOAuth.characterization.test.ts"
  ],
  "source": "src/providers/oauth/codexCredentials.ts",
  "probes": [
    {
      "name": "credentials move to another key of the store",
      "find": "export const CODEX_STORAGE_KEY = 'codex' as const",
      "replace": "export const CODEX_STORAGE_KEY = 'codexAuth' as const"
    },
    {
      "name": "no early-refresh skew",
      "find": "const CODEX_TOKEN_REFRESH_SKEW_MS = 60_000",
      "replace": "const CODEX_TOKEN_REFRESH_SKEW_MS = 0"
    },
    {
      "name": "cooldown boundary becomes inclusive",
      "find": "now - lastRefreshFailureAt < CODEX_TOKEN_REFRESH_RETRY_COOLDOWN_MS",
      "replace": "now - lastRefreshFailureAt <= CODEX_TOKEN_REFRESH_RETRY_COOLDOWN_MS"
    },
    {
      "name": "concurrent callers no longer share the in-flight refresh",
      "find": "  if (inFlightCodexRefresh) {",
      "replace": "  if (false as boolean) {"
    },
    {
      "name": "error code is reported in another shape",
      "find": "`Codex token refresh failed (${code}): ${message}`",
      "replace": "`Codex token refresh failed [${code}]: ${message}`"
    },
    {
      "name": "a rotated refresh token is discarded",
      "find": "asTrimmedString(payload.refresh_token) ?? current.refreshToken",
      "replace": "current.refreshToken"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "client id override is no longer trimmed",
      "find": "return asTrimmedString(env.CODEX_OAUTH_CLIENT_ID) ?? DEFAULT_CODEX_OAUTH_CLIENT_ID",
      "replace": "return env.CODEX_OAUTH_CLIENT_ID || DEFAULT_CODEX_OAUTH_CLIENT_ID"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "port 0 is rejected",
      "find": "parsed >= 0 && parsed <= 65535",
      "replace": "parsed > 0 && parsed <= 65535"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "top-level account claim is ignored",
      "find": "        payload?.chatgpt_account_id ??",
      "replace": "        payload?.sub ??"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "organization fallback reads the wrong field",
      "find": "      ? (orgs[0] as Record<string, unknown>).id",
      "replace": "      ? (orgs[0] as Record<string, unknown>).name"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "apostrophe escaped differently",
      "find": "        return '&#39;'",
      "replace": "        return '&apos;'"
    },
    {
      "source": "src/providers/oauth/codexOAuthShared.ts",
      "name": "exchange asks for another token type",
      "find": "    requested_token: CODEX_API_KEY_TOKEN_NAME,",
      "replace": "    requested_token: 'access_token',"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "PKCE method downgraded to plain",
      "find": "authUrl.searchParams.append('code_challenge_method', 'S256')",
      "replace": "authUrl.searchParams.append('code_challenge_method', 'plain')"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "code exchange sends the wrong verifier",
      "find": "    code_verifier: options.codeVerifier,",
      "replace": "    code_verifier: options.authorizationCode,"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "account id prefers the access token",
      "find": "      parseChatgptAccountId(idToken) ?? parseChatgptAccountId(accessToken),",
      "replace": "      parseChatgptAccountId(accessToken) ?? parseChatgptAccountId(idToken),"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "failure page served with a success status",
      "find": "isCancellation ? 200 : 400",
      "replace": "isCancellation ? 200 : 200"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "late cancellation no longer discards the tokens",
      "find": "        if (this.authCodeListener !== authCodeListener) {",
      "replace": "        if (false as boolean) {"
    },
    {
      "source": "src/providers/oauth/codexOAuth.ts",
      "name": "errors mentioning the port are no longer rewritten",
      "find": "        message.includes(String(callbackPort))",
      "replace": "        false"
    }
  ]
}
