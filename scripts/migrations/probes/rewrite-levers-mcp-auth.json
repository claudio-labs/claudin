{
  "test": [
    "src/mcp/auth/claudeAuthProvider.characterization.test.ts",
    "src/mcp/auth/oauthFlow.characterization.test.ts",
    "src/mcp/auth/authFetch.characterization.test.ts",
    "src/mcp/auth/tokenRevocation.characterization.test.ts",
    "src/mcp/auth/clientSecretStore.characterization.test.ts"
  ],
  "source": "src/mcp/auth/claudeAuthProvider.ts",
  "probes": [
    {
      "name": "authFetch: a POST without a caller signal is normalised",
      "find": "    return isPost ? normalizeOAuthErrorBody(response) : response",
      "replace": "    return isPost && init?.signal ? normalizeOAuthErrorBody(response) : response",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "authFetch: a POST with a caller signal is normalised",
      "find": "    return isPost ? normalizeOAuthErrorBody(response) : response",
      "replace": "    return isPost && !init?.signal ? normalizeOAuthErrorBody(response) : response",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "authFetch: aborting the caller signal aborts the request",
      "find": "      ? AbortSignal.any([init.signal, deadline])",
      "replace": "      ? deadline",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "authFetch: a configured metadata URL must be https",
      "find": "  if (!metadataUrl.startsWith('https://')) {",
      "replace": "  if (metadataUrl.startsWith('ftp://')) {",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "authFetch: the path-aware legacy fallback is tried for a URL with a path",
      "find": "  if (resource.pathname === '/') return undefined",
      "replace": "  if (resource.pathname !== '') return undefined",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "authFetch: a given resource metadata URL is passed to discovery",
      "find": "      resourceMetadataUrl,\n      fetchFn,\n",
      "replace": "      fetchFn,\n",
      "source": "src/mcp/auth/authFetch.ts"
    },
    {
      "name": "revocation: post is chosen only when basic is not offered",
      "find": "    advertised.includes('client_secret_post') &&\n    !advertised.includes('client_secret_basic')",
      "replace": "    advertised.includes('client_secret_post')",
      "source": "src/mcp/auth/revocation/clientAuth.ts"
    },
    {
      "name": "revocation: the revocation endpoint's own method list is preferred",
      "find": "    metadata.revocation_endpoint_auth_methods_supported ??\n    metadata.token_endpoint_auth_methods_supported",
      "replace": "    metadata.token_endpoint_auth_methods_supported",
      "source": "src/mcp/auth/revocation/clientAuth.ts"
    },
    {
      "name": "revocation: Basic credentials are URL-encoded first",
      "find": "  const pair = `${encodeURIComponent(clientId)}:${encodeURIComponent(clientSecret)}`",
      "replace": "  const pair = `${clientId}:${clientSecret}`",
      "source": "src/mcp/auth/revocation/clientAuth.ts"
    },
    {
      "name": "revocation: the Bearer retry drops client credentials from the body",
      "find": "      { kind: 'none' },\n      accessToken,",
      "replace": "      auth,\n      accessToken,",
      "source": "src/mcp/auth/revocation/signOut.ts"
    },
    {
      "name": "revocation: the authorization server from discovery is asked",
      "find": "    entry.discoveryState?.authorizationServerUrl ?? config.url",
      "replace": "    config.url",
      "source": "src/mcp/auth/revocation/signOut.ts"
    },
    {
      "name": "revocation: re-authentication keeps the step-up state",
      "find": "    preserveStepUpState && entry ? stepUpRemnant(entry) : undefined",
      "replace": "    (false as boolean) && entry ? stepUpRemnant(entry) : undefined",
      "source": "src/mcp/auth/revocation/signOut.ts"
    },
    {
      "name": "secrets: MCP_CLIENT_SECRET is read",
      "find": "  const fromEnv = process.env[SECRET_ENV_VAR]",
      "replace": "  const fromEnv = process.env[`${SECRET_ENV_VAR}_UNSET`]",
      "source": "src/mcp/auth/clientSecretStore.ts"
    },
    {
      "name": "secrets: DEL is a backspace",
      "find": "const BACKSPACE_KEYS: ReadonlySet<string> = new Set(['\\u007F', '\\b'])",
      "replace": "const BACKSPACE_KEYS: ReadonlySet<string> = new Set(['\\b'])",
      "source": "src/mcp/auth/hiddenPrompt.ts"
    },
    {
      "name": "secrets: Ctrl+C cancels",
      "find": "        reject(new Error('Cancelled'))",
      "replace": "        resolve(typed)",
      "source": "src/mcp/auth/hiddenPrompt.ts"
    },
    {
      "name": "secrets: Enter detaches the keystroke listener",
      "find": "      stdin.removeListener('data', onData)\n",
      "replace": "",
      "source": "src/mcp/auth/hiddenPrompt.ts"
    },
    {
      "name": "secrets: the secret is stored under the server key",
      "find": "    [key]: { clientSecret },",
      "replace": "    [key]: { secret: clientSecret },",
      "source": "src/mcp/auth/credentialMaps.ts"
    },
    {
      "name": "secrets: clearing deletes the server's secret",
      "find": "  writeStore({ ...store, mcpOAuthClientConfig: withoutKey(map, key) })",
      "replace": "  writeStore({ ...store, mcpOAuthClientConfig: map })",
      "source": "src/mcp/auth/credentialMaps.ts"
    }
  ]
}
