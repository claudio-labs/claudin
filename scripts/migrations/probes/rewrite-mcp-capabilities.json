      "find": "config: { ...config, scope: 'dynamic' as const },",
      "replace": "config: { ...config, scope: 'user' as const },"
    },
    {
      "name": "sdk: failed servers scoped dynamic",
      "source": "src/mcp/client/sdkClients.ts",
      "find": "config: { ...config, scope: 'user' as const },",
      "replace": "config: { ...config, scope: 'dynamic' as const },"
    },
    {
