    {
      "name": "reconnect: a connector is not recorded as connected",
      "find": "    if (config.type === 'claudeai-proxy') {\n      markClaudeAiMcpConnected(name)\n    }\n\n    const supportsResources",
      "replace": "    const supportsResources"
    },
    {
      "name": "sweep: the needs-auth cache is ignored",
      "find": "((await isMcpAuthCached(name)) ||",
      "replace": "((false) ||"
    },
    {
      "name": "sweep: probed-without-token servers are contacted",
      "find": "hasMcpDiscoveryButNoToken(name, config)))",
      "replace": "false))"
    },
    {
      "name": "sweep: needs-auth from the connect gets no authenticate tool",
      "find": "            client.type === 'needs-auth'\n",
      "replace": "            client.type === 'failed'\n"
    },
    {
      "name": "sweep: resource tools added for every server",
      "find": "if (supportsResources && !resourceToolsAdded) {",
      "replace": "if (supportsResources) {"
    },
    {
      "name": "sdk: connected servers scoped user",
