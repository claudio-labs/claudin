      "find": "if (!tokens.scopes?.includes('user:mcp_servers')) {",
      "replace": "if (!tokens.scopes?.includes('user:mcp')) {"
    },
    {
      "name": "claudeai: names lose the claude.ai prefix",
      "source": "src/mcp/claudeai.ts",
      "find": "const baseName = `claude.ai ${server.display_name}`",
      "replace": "const baseName = `${server.display_name}`"
    },
    {
      "name": "claudeai: essential-traffic mode no longer blocks the fetch",
      "source": "src/mcp/claudeai.ts",
      "find": "      if (isEssentialTrafficOnly()) {",
      "replace": "      if (false) {"
    },
    {
      "name": "claudeai: clearing keeps the needs-auth cache",
      "source": "src/mcp/claudeai.ts",
      "find": "  clearMcpAuthCache()\n}",
      "replace": "}"
    },
    {
      "name": "claudeai: connected names recorded twice",
      "source": "src/mcp/claudeai.ts",
      "find": "    if (seen.includes(name)) return current\n",
      "replace": ""
    }
  ]
}
