    {
      "name": "ide: the whole result is returned",
      "source": "src/mcp/client/ide.ts",
      "find": "  return result.content\n",
      "replace": "  return result as never\n"
    },
    {
      "name": "claudeai: beta header changes",
      "source": "src/mcp/claudeai.ts",
      "find": "const MCP_SERVERS_BETA_HEADER = 'mcp-servers-2025-12-04'",
      "replace": "const MCP_SERVERS_BETA_HEADER = 'mcp-servers'"
    },
    {
