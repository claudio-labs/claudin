{
  "test": [
    "src/mcp/client.capabilities.characterization.test.ts"
  ],
  "source": "src/mcp/client/fetchCapabilities.ts",
  "probes": [
    {
      "name": "tools: two tries instead of three",
      "find": "for (let attempt = 0; attempt < 3; attempt++) {",
      "replace": "for (let attempt = 0; attempt < 2; attempt++) {"
    },
    {
      "name": "tools: no back-off between tries",
      "find": "await sleep(1000 * (attempt + 1))",
      "replace": "await sleep(10)"
    },
    {
      "name": "tools: the no-prefix switch is ignored",
      "find": "isEnvTruthy(process.env.CLAUDE_AGENT_SDK_MCP_NO_PREFIX)",
      "replace": "false"
    },
    {
      "name": "tools: search hints keep newlines and tabs",
      "find": ".replace(/\\s+/g, ' ')",
      "replace": ".replace(/ +/g, ' ')"
    },
    {
      "name": "tools: a blank search hint is kept as empty text",
      "find": ".trim() || undefined",
      "replace": ".trim()"
    },
    {
      "name": "tools: alwaysLoad accepts any value",
      "find": "alwaysLoad: tool._meta?.['anthropic/alwaysLoad'] === true,",
      "replace": "alwaysLoad: tool._meta?.['anthropic/alwaysLoad'] !== undefined,"
    },
    {
      "name": "tools: prompt cap drops the marker",
      "find": "desc.slice(0, MAX_MCP_DESCRIPTION_LENGTH) + '… [truncated]'",
      "replace": "desc.slice(0, MAX_MCP_DESCRIPTION_LENGTH)"
    },
    {
      "name": "tools: a 2048-character description is cut",
      "find": "desc.length > MAX_MCP_DESCRIPTION_LENGTH",
      "replace": "desc.length >= MAX_MCP_DESCRIPTION_LENGTH"
    },
    {
      "name": "tools: concurrency-safe by default",
      "find": "isConcurrencySafe() {\n              return tool.annotations?.readOnlyHint ?? false",
      "replace": "isConcurrencySafe() {\n              return tool.annotations?.readOnlyHint ?? true"
    },
    {
      "name": "tools: destructive by default",
      "find": "return tool.annotations?.destructiveHint ?? false",
      "replace": "return tool.annotations?.destructiveHint ?? true"
    },
    {
      "name": "tools: suggested rule goes to user settings",
      "find": "destination: 'localSettings' as const,",
      "replace": "destination: 'userSettings' as const,"
    },
    {
      "name": "tools: tool_use id travels under another _meta key",
      "find": "? { 'claudecode/toolUseId': toolUseId }",
      "replace": "? { 'claudin/toolUseId': toolUseId }"
    },
    {
      "name": "tools: completed progress renamed",
      "find": "status: 'completed',",
      "replace": "status: 'done',"
    },
    {
      "name": "tools: failed progress renamed",
      "find": "status: 'failed',",
      "replace": "status: 'error',"
    },
    {
      "name": "tools: no retry after an expired session",
      "find": "const MAX_SESSION_RETRIES = 1",
      "replace": "const MAX_SESSION_RETRIES = 0"
    },
    {
      "name": "tools: structuredContent dropped from mcpMeta",
      "find": "structuredContent: mcpResult.structuredContent,",
      "replace": "structuredContent: undefined,"
    },
    {
      "name": "tools: the ide filter is gone",
      "find": "        .filter(isIncludedMcpTool)\n",
      "replace": ""
    },
    {
      "name": "resources: no longer tagged with the server",
      "find": "        server: client.name,",
      "replace": "        server: 'unknown',"
    },
    {
      "name": "commands: server name not normalized",
      "find": "name: 'mcp__' + normalizeNameForMCP(client.name) + '__' + prompt.name,",
      "replace": "name: 'mcp__' + client.name + '__' + prompt.name,"
    },
    {
      "name": "commands: arguments split on commas",
      "find": "const argsArray = args.split(' ')",
