{
  "test": [
    "src/permissions/ui/FallbackPermissionRequest.characterization.test.tsx",
    "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.characterization.test.tsx",
    "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.characterization.test.tsx",
    "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.characterization.test.tsx",
    "src/permissions/ui/toolDialogs/toolDialogs.fixes.test.tsx"
  ],
  "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
  "probes": [
    {
      "name": "rules: allow-always saved to the user settings",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "destination: 'localSettings'",
      "replace": "destination: 'userSettings'"
    },
    {
      "name": "rules: allow-always saved as an ask rule",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "behavior: 'allow', destination",
      "replace": "behavior: 'ask', destination"
    },
    {
      "name": "rules (Finding 1): an empty skill name gets the bare Skill rule",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "if (skill === '') return null",
      "replace": "if (skill === '\\u0000') return null"
    },
    {
      "name": "rules: a leading space splits off a prefix",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "space > 0 ?",
      "replace": "space >= 0 ?"
    },
    {
      "name": "rules: the skill prefix widened to the first letter",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "${skill.slice(0, space)}:*",
      "replace": "${skill.slice(0, 1)}:*"
    },
    {
      "name": "rules: the skill rule loses its content (the bare Skill rule)",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "return { toolName: SKILL_TOOL_NAME, ruleContent: content }",
      "replace": "return { toolName: SKILL_TOOL_NAME }"
    },
    {
      "name": "rules (Finding 4): a URL with no host offers a domain rule",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "return hostname === '' ? null : hostname",
      "replace": "return hostname"
    },
    {
      "name": "rules: an unparseable URL is not guarded",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "if (typeof url !== 'string' || !URL.canParse(url)) return null",
      "replace": "if (typeof url !== 'string') return null"
    },
    {
      "name": "rules: the fetch rule widened to every domain",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "ruleContent: `domain:${host}`",
      "replace": "ruleContent: 'domain:*'"
    },
    {
      "name": "rules: the shell rule widened to one word",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "const WORDS_IN_PREFIX = 2",
      "replace": "const WORDS_IN_PREFIX = 1"
    },
    {
      "name": "rules: a wordless command saves the bare Bash prefix",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "if (words.length === 0) return null\n",
      "replace": ""
    },
    {
      "name": "rules: the shell rule is saved for the tool, not Bash",
      "source": "src/permissions/ui/toolDialogs/rules.ts",
      "find": "return { toolName: BASH_TOOL_NAME, ruleContent",
      "replace": "return { toolName: 'WaitFor', ruleContent"
    },
    {
      "name": "prompt: managed policy ignored",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "shouldShowAlwaysAllowOptions() ? always : NONE",
      "replace": "always"
    },
    {
      "name": "prompt: Yes saves the first allow-always rule",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "toolUseConfirm.onAllow(toolUseConfirm.input, [], note)",
      "replace": "toolUseConfirm.onAllow(toolUseConfirm.input, offered[0]?.rule ? [addAllowRule(offered[0].rule)] : [], note)"
    },
    {
      "name": "prompt: No allows",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "toolUseConfirm.onReject(note)",
      "replace": "toolUseConfirm.onAllow(toolUseConfirm.input, [], note)"
    },
    {
      "name": "prompt: Esc allows",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "const onCancel = useCallback(() => {\n    toolUseConfirm.onReject()",
      "replace": "const onCancel = useCallback(() => {\n    toolUseConfirm.onAllow(toolUseConfirm.input, [])"
    },
    {
      "name": "prompt: No skips the caller's onReject",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "        toolUseConfirm.onReject(note)\n        onReject()\n",
      "replace": "        toolUseConfirm.onReject(note)\n"
    },
    {
      "name": "prompt: an allow-always option takes a note",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "({ value: option.value, label: option.label })",
      "replace": "({ value: option.value, label: option.label, feedbackConfig: { type: 'accept' as const } })"
    },
    {
      "name": "prompt: allow-always passes a third argument",
      "source": "src/permissions/ui/toolDialogs/useToolPrompt.ts",
      "find": "chosen.rule ? [addAllowRule(chosen.rule)] : [])",
      "replace": "chosen.rule ? [addAllowRule(chosen.rule)] : [], 'note')"
    },
    {
      "name": "label: the subject is not bold",
      "source": "src/permissions/ui/toolDialogs/DontAskAgainLabel.tsx",
      "find": "<Text bold>{subject}</Text>",
      "replace": "{subject}"
    },
    {
      "name": "label: the directory is left out",
      "source": "src/permissions/ui/toolDialogs/DontAskAgainLabel.tsx",
      "find": "inCwd = true",
      "replace": "inCwd = false"
    },
    {
      "name": "fallback: the rule names the shown name",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "wholeToolRule(tool.name)",
      "replace": "wholeToolRule(name)"
    },
    {
      "name": "fallback: the MCP suffix is dropped",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "{isMcp && <Text dimColor>{MCP_SUFFIX}</Text>}",
      "replace": "{null}"
    },
    {
      "name": "fallback: the call follows the caller's verbose",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "verbose: true",
      "replace": "verbose: props.verbose"
    },
    {
      "name": "fallback: the description is not truncated",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "truncateToLines(description, DESCRIPTION_LINES)",
      "replace": "description"
    },
    {
      "name": "fallback: the explanation speaks of a command",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "toolType=\"tool\"",
      "replace": "toolType=\"command\""
    },
    {
      "name": "fallback: no prompt counted",
      "source": "src/permissions/ui/FallbackPermissionRequest.tsx",
      "find": "usePermissionRequestLogging(toolUseConfirm, LOGGED)",
      "replace": ""
    },
    {
      "name": "skill (Finding 1): unreadable input offers the bare Skill rule",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "if (!contents) return []",
      "replace": "if (!contents) return [{ value: 'yes-exact', label: 'always', rule: skillRule('') }]"
    },
    {
      "name": "skill: an allow carries the description too",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "if (result.behavior !== 'ask') return undefined",
      "replace": ""
    },
    {
      "name": "skill (Finding 9): an empty line where no description is",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "description !== '' ? description : undefined",
      "replace": "description !== '' ? description : ' '"
    },
    {
      "name": "skill: the prefix label loses its noun",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "subject={contents.prefix} noun=\"commands\"",
      "replace": "subject={contents.prefix}"
    },
    {
      "name": "skill: the title loses its quotes",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "title={`Use skill \"${skill}\"?`}",
      "replace": "title={`Use skill ${skill}?`}"
    },
    {
      "name": "skill: the prefix option saves the exact rule",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "rule: skillRule(contents.prefix)",
      "replace": "rule: skillRule(contents.exact)"
    },
    {
      "name": "skill: no prompt counted",
      "source": "src/permissions/ui/SkillPermissionRequest/SkillPermissionRequest.tsx",
      "find": "usePermissionRequestLogging(toolUseConfirm, LOGGED)",
      "replace": ""
    },
    {
      "name": "fetch: managed policy ignored",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "shouldShowAlwaysAllowOptions() ? readableHost(input) : null",
      "replace": "readableHost(input)"
    },
    {
      "name": "fetch (Finding 4): input the schema refuses offers a domain rule",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "return parsed.success ? fetchHost(parsed.data.url) : null",
      "replace": "return fetchHost((input as { url?: unknown }).url)"
    },
    {
      "name": "fetch (Finding 4): a non-string URL is rendered raw",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "typeof input.url === 'string' ? WebFetchTool",
      "replace": "true ? WebFetchTool"
    },
    {
      "name": "fetch: Yes saves the domain rule",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "choice === 'yes-domain' && host !== null ?",
      "replace": "host !== null ?"
    },
    {
      "name": "fetch: No allows",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "if (choice === 'no') return reject()",
      "replace": "if (choice === 'no') return toolUseConfirm.onAllow(input, [])"
    },
    {
      "name": "fetch: Esc allows",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "onCancel={reject}",
      "replace": "onCancel={() => choose('yes')}"
    },
    {
      "name": "fetch: the call ignores verbose",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "{ theme, verbose })",
      "replace": "{ theme, verbose: false })"
    },
    {
      "name": "fetch: (esc) is not bold",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "<Text bold>(esc)</Text>",
      "replace": "(esc)"
    },
    {
      "name": "fetch: no prompt counted",
      "source": "src/permissions/ui/WebFetchPermissionRequest/WebFetchPermissionRequest.tsx",
      "find": "usePermissionRequestLogging(toolUseConfirm, LOGGED)",
      "replace": ""
    },
    {
      "name": "monitor: setup decides the rule",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "rule: shellDelegateRule(command)",
      "replace": "rule: shellDelegateRule(textField(input.setup) || command)"
    },
    {
      "name": "monitor: the command is not shown",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "{label}({command})",
      "replace": "{label}()"
    },
    {
      "name": "monitor: the request description replaces the input's",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "{description !== '' && <Text dimColor>{description}</Text>}",
      "replace": "<Text dimColor>{toolUseConfirm.description}</Text>"
    },
    {
      "name": "monitor: the label loses its noun",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "subject={label} noun=\"commands\"",
      "replace": "subject={label}"
    },
    {
      "name": "monitor: the title is fixed",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "title={label}",
      "replace": "title=\"Shell\""
    },
    {
      "name": "monitor: no prompt counted",
      "source": "src/permissions/ui/MonitorPermissionRequest/MonitorPermissionRequest.tsx",
      "find": "usePermissionRequestLogging(toolUseConfirm, LOGGED)",
      "replace": ""
    },
    {
      "name": "select (Finding 6): the option number may shrink",
      "source": "src/terminal/custom-select/select.tsx",
      "find": "{!hideIndexes && <Box flexShrink={0}><Text dimColor={true}>{`${i_3}.`.padEnd(maxIndexWidth_1 + 2)}</Text></Box>}",
      "replace": "{!hideIndexes && <Text dimColor={true}>{`${i_3}.`.padEnd(maxIndexWidth_1 + 2)}</Text>}"
    }
  ]
