    { "name": "scan: pr-link is a metadata kind", "find": "  'pr-link',\n", "replace": "" },
    { "name": "scan: a marker includes the quote closing the kind", "find": "kind => `\"type\":\"${kind}\"`,", "replace": "kind => `\"type\":\"${kind}`," },
    { "name": "scan: the byte at endOffset is never read", "find": "const wanted = Math.min(piece.length, endOffset - position)", "replace": "const wanted = piece.length" },
    { "name": "fix 2: an empty or negative range returns []", "find": "    if (!(endOffset > 0)) return found\n", "replace": "" },
    { "name": "scan: a last line without a newline is still a line", "find": "    if (openLine.length > 0) keep(NO_BYTES)\n", "replace": "" },
    { "name": "scan: metadata lines come back in file order", "find": "if (line !== null) found.push(line.toString('utf8'))", "replace": "if (line !== null) found.unshift(line.toString('utf8'))" },
    { "name": "scan: a line with no carry is kept when it has a marker", "find": "return hasMetadataMarker(chunkBuf) ? chunkBuf : null", "replace": "return null" },
    { "name": "scan: the open line is copied before the piece buffer is reused", "find": "openLine.push(Buffer.from(view.subarray(lineStart)))", "replace": "openLine.push(view.subarray(lineStart))" },
    { "name": "scan: a marker in the carried head keeps the line", "find": "    hasMetadataMarker(carry) ||\n", "replace": "" },
    { "name": "scan: a marker split by a piece seam keeps the line", "find": "    hasMetadataMarker(seam) ||\n", "replace": "" },
    { "name": "scan: the seam window covers the longest marker", "find": "const SEAM_WINDOW = METADATA_PREFIX_BOUND - 1", "replace": "const SEAM_WINDOW = METADATA_PREFIX_BOUND - 15" },
    { "name": "scan: a line spanning several pieces is joined whole", "find": "return pieces.length === 1 ? pieces[0]! : Buffer.concat(pieces)", "replace": "return pieces[0]!" },

    { "name": "walk: the leaf is the last non-sidechain message", "find": "if (!link.sidechain) leaf = index", "replace": "leaf = index" },
    { "name": "fix 3: only a top-level isSidechain makes a sidechain line", "find": "sidechain: hasTopLevelMember(buf, line, SIDECHAIN_MEMBER),", "replace": "sidechain: occurrences(buf, SIDECHAIN_MEMBER, line.start, line.contentEnd).length > 0," },
    { "name": "walk: a nested message before the top-level uuid is not taken", "find": "  return firstTopLevelMember(buf, lineStart, candidates)\n", "replace": "  return candidates[0] ?? -1\n" },
    { "name": "walk: a nested record after the top-level uuid is not taken", "find": "  return firstTopLevelMember(buf, lineStart, candidates)\n", "replace": "  return candidates.at(-1) ?? -1\n" },
    { "name": "walk: a uuid is exactly 36 characters between quotes", "find": "if (buf[quoteAt] !== QUOTE || close >= end || buf[close] !== QUOTE) return null", "replace": "if (buf[quoteAt] !== QUOTE || close >= end) return null" },
    { "name": "walk: the parent links the chain", "find": "parent: quotedUuidAt(buf, parentAt, contentEnd),", "replace": "parent: null," },
    { "name": "walk: a parent cycle ends the walk keeping what it reached", "find": "if (visited.has(link.uuid)) break", "replace": "if (visited.has(link.uuid)) { chain.clear(); chainBytes = 0; break }" },
    { "name": "walk: no leaf returns the bytes as given", "find": "if (leaf === -1) return buf", "replace": "if (leaf === -1) return Buffer.alloc(0)" },
    { "name": "walk: half rounded down is the cut threshold", "find": "if (buf.length - chainBytes < Math.floor(buf.length / 2)) return buf", "replace": "if (buf.length - chainBytes < Math.ceil(buf.length / 2)) return buf" },
    { "name": "walk: exactly half is cut", "find": "if (buf.length - chainBytes < Math.floor(buf.length / 2)) return buf", "replace": "if (buf.length - chainBytes <= Math.floor(buf.length / 2)) return buf" },
    { "name": "walk: chain bytes count their newline", "find": "chainBytes += lines[index]!.end - lines[index]!.start", "replace": "chainBytes += lines[index]!.contentEnd - lines[index]!.start" },
    { "name": "walk: metadata lines are kept", "find": "if (links[index] === null || chain.has(index))", "replace": "if (chain.has(index))" },
    { "name": "walk: kept lines keep their newline bytes", "find": "kept.push(buf.subarray(line.start, line.end))", "replace": "kept.push(buf.subarray(line.start, line.contentEnd))" },

    { "name": "structure: an even backslash run does not escape the quote", "source": "src/sessions/indexing/byteScan/jsonStructure.ts", "find": "if (backslashes % 2 === 0) return quote", "replace": "if (backslashes === 0) return quote" },
    { "name": "structure: string contents are skipped whole", "source": "src/sessions/indexing/byteScan/jsonStructure.ts", "find": "      at = close + 1\n      continue\n", "replace": "      at++\n      continue\n" },
    { "name": "structure: arrays nest too", "source": "src/sessions/indexing/byteScan/jsonStructure.ts", "find": "if (byte === OPEN_BRACE || byte === OPEN_BRACKET) depth++", "replace": "if (byte === OPEN_BRACE) depth++" },
    { "name": "structure: only depth one is the outermost object", "source": "src/sessions/indexing/byteScan/jsonStructure.ts", "find": "if (depth === 1 && wanted.has(at)) return at", "replace": "if (depth >= 1 && wanted.has(at)) return at" },
    { "name": "structure: occurrences stay inside the range", "source": "src/sessions/indexing/byteScan/jsonStructure.ts", "find": "const range = buf.subarray(from, to)", "replace": "const range = buf.subarray(from)" },

    { "name": "listing: one worktree lists the original cwd", "source": "src/sessions/indexing/crossProject.ts", "find": "if (worktreePaths.length <= 1) {", "replace": "if (worktreePaths.length === 0) {" },
    { "name": "listing: the original cwd is the projectPath", "source": "src/sessions/indexing/crossProject.ts", "find": "{ dir: getProjectDir(cwd), projectPath: cwd }", "replace": "{ dir: getProjectDir(cwd) }" },
    { "name": "listing: a subdirectory folder belongs to its worktree", "source": "src/sessions/indexing/crossProject.ts", "find": " || folderName.startsWith(`${key.folderName}-`)", "replace": "" },
    { "name": "listing: the longest worktree wins", "source": "src/sessions/indexing/crossProject.ts", "find": "key.folderName.length > best.folderName.length ? key : best", "replace": "key.folderName.length < best.folderName.length ? key : best" },
    { "name": "listing: names fold case on Windows", "source": "src/sessions/indexing/crossProject.ts", "find": "? name => name.toLowerCase() : name => name", "replace": "? name => name : name => name" },
    { "name": "fix 1: limit applies per folder in every listing", "source": "src/sessions/indexing/crossProject.ts", "find": "getSessionFilesLite(folder.dir, limit, folder.projectPath)", "replace": "getSessionFilesLite(folder.dir, undefined, folder.projectPath)" },
    { "name": "listing: a session in two folders is listed once", "source": "src/sessions/indexing/crossProject.ts", "find": "return deduplicateLogsBySessionId(perFolder.flat())", "replace": "return perFolder.flat()" },
    { "name": "listing: shown entries are numbered from 0", "source": "src/sessions/indexing/crossProject.ts", "find": "logs: logs.map((log, value) => ({ ...log, value })),", "replace": "logs," },
    { "name": "listing: options.initialEnrichCount is honoured", "source": "src/sessions/indexing/crossProject.ts", "find": "const count = options?.initialEnrichCount ?? INITIAL_ENRICH_COUNT", "replace": "const count = INITIAL_ENRICH_COUNT" },
    { "name": "listing: a missing projects folder lists nothing", "source": "src/sessions/indexing/crossProject.ts", "find": "    if (isFsInaccessible(error)) return null\n", "replace": "" },
    { "name": "listing: the first read starts at the top of the listing", "source": "src/sessions/indexing/crossProject.ts", "find": "await enrichLogs(allStatLogs, 0, count)", "replace": "await enrichLogs(allStatLogs, 1, count)" },

    { "name": "sidecar: lives beside the transcript as .meta.json", "source": "src/sessions/indexing/agents.ts", "find": ".replace(TRANSCRIPT_SUFFIX, '.meta.json')", "replace": ".replace(TRANSCRIPT_SUFFIX, '.json')" },
    { "name": "sidecar: compact JSON in the order given", "source": "src/sessions/indexing/agents.ts", "find": "await replaceFile(path, JSON.stringify(metadata))", "replace": "await replaceFile(path, JSON.stringify(metadata, null, 2))" },
    { "name": "sidecar: writing creates the folders", "source": "src/sessions/indexing/agents.ts", "find": "  await mkdir(dirname(path), { recursive: true })\n", "replace": "" },
    { "name": "fix 4: the write lands as a new file", "source": "src/sessions/indexing/agents.ts", "find": "    await writeFile(staging, contents, 'utf8')\n    await rename(staging, path)\n", "replace": "    await writeFile(path, contents, 'utf8')\n" },
    { "name": "fix 4: a failed write leaves no staging file", "source": "src/sessions/indexing/agents.ts", "find": "    await rm(staging, { force: true })\n", "replace": "" },
    { "name": "sidecar: a missing or unreachable sidecar reads as null", "source": "src/sessions/indexing/agents.ts", "find": "if (isFsInaccessible(error) || getErrnoCode(error) === 'EISDIR') return null", "replace": "if (getErrnoCode(error) === 'EISDIR') return null" },
    { "name": "fix 4: a directory sidecar reads as null", "source": "src/sessions/indexing/agents.ts", "find": "if (isFsInaccessible(error) || getErrnoCode(error) === 'EISDIR') return null", "replace": "if (isFsInaccessible(error)) return null" },
    { "name": "fix 4: invalid JSON reads as null", "source": "src/sessions/indexing/agents.ts", "find": "  } catch {\n    return null\n  }\n", "replace": "  } catch (error) {\n    throw error\n  }\n" },
    { "name": "fix 4: a value that is not agent metadata reads as null", "source": "src/sessions/indexing/agents.ts", "find": "return isAgentMetadata(stored) ? stored : null", "replace": "return stored as AgentMetadata" },
    { "name": "fix 4: agentType must be a string", "source": "src/sessions/indexing/agents.ts", "find": "typeof value.agentType === 'string'", "replace": "value.agentType !== undefined" },
