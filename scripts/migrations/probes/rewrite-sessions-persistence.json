{
  "test": [
    "src/sessions/persistence.characterization.test.ts",
    "src/sessions/persistence.metadata.characterization.test.ts",
    "src/sessions/persistence.remote.characterization.test.ts",
    "src/sessions/persistence/persistenceFixes.test.ts",
    "src/sessions/persistence/writer/writer.test.ts"
  ],
  "source": "src/sessions/persistence/project.ts",
  "probes": [
    {
      "name": "file: only a user or assistant message opens the transcript",
      "find": "      if (!opensTranscript(entry)) {",
      "replace": "      if (false) {"
