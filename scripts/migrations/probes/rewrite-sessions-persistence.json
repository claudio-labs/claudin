      "find": "    this.ingressUrl = url\n    this.queue.delayMs = REMOTE_FLUSH_INTERVAL_MS\n",
      "replace": "    this.ingressUrl = url\n"
    },
    {
      "name": "queue: flushSessionStorage rejects with the failed append's error",
      "find": "    if (failure) throw failure.error",
      "replace": "    void failure"
    },
    {
      "name": "finding 6: the timer path logs a failed batch instead of rejecting unhandled",
      "find": "      this.drainQueuedWrites().catch(logError)",
      "replace": "      void this.drainQueuedWrites()"
    },
    {
