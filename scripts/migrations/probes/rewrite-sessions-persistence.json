    {
      "name": "file: entries held before it opens are written when it does",
      "find": "    const held = this.heldEntries\n",
      "replace": "    const held: Entry[] = []\n"
    },
    {
      "name": "file: the cached metadata leads a new transcript",
      "find": "      this.reAppendSessionMetadata(skipTitleRefresh)\n    } catch",
      "replace": "      void skipTitleRefresh\n    } catch"
    },
    {
      "name": "file: resetting the pointer drops the held entries",
      "find": "    this.sessionFile = null\n    this.heldEntries = []\n",
      "replace": "    this.sessionFile = null\n"
    },
    {
      "name": "queue: lines wait about 100 ms for the timer",
      "source": "src/sessions/persistence/writer/queueState.ts",
      "find": "const DRAIN_DELAY_MS = 100",
      "replace": "const DRAIN_DELAY_MS = 15"
    },
    {
