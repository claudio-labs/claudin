      "source": "src/sessions/persistence/writer/lines.ts",
      "find": "return { parentUuid: null, logicalParentUuid: parent ?? undefined }",
      "replace": "return { parentUuid: parent, logicalParentUuid: parent ?? undefined }"
    },
    {
