{
  "test": [
    "src/sessions/sessionUrl.characterization.test.ts",
    "src/sessions/sessionIngressAuth.characterization.test.ts",
    "src/sessions/hooks/useTeleportResume.characterization.test.tsx"
  ],
  "source": "src/sessions/sessionIngressAuth.ts",
  "probes": [
    {
      "name": "ingress: the access-token variable wins",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "const envToken = process.env.CLAUDE_CODE_SESSION_ACCESS_TOKEN",
      "replace": "const envToken = process.env.CLAUDE_CODE_SESSION_ACCESS_TOKEN_OFF"
    },
    {
      "name": "ingress: only session keys become a cookie",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "if (token.startsWith('sk-ant-sid')) {",
      "replace": "if (token.startsWith('sk-ant-')) {"
    },
    {
      "name": "ingress: the organization header name",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "headers['X-Organization-Uuid'] = orgUuid",
      "replace": "headers['X-Organization-Id'] = orgUuid"
    },
    {
      "name": "ingress: the first answer is kept",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "if (cachedToken !== undefined) {",
      "replace": "if (false) {"
    },
    {
      "name": "ingress: a non-numeric descriptor gives nothing",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "if (Number.isNaN(fd)) {",
      "replace": "if (false) {"
    },
    {
      "name": "ingress: update sets the access-token variable",
      "source": "src/sessions/sessionIngressAuth.ts",
      "find": "process.env.CLAUDE_CODE_SESSION_ACCESS_TOKEN = token",
      "replace": "process.env.CLAUDE_CODE_SESSION_ACCESS_TOKEN_NEXT = token"
    },
    {
      "name": "url: .jsonl marks a transcript file",
      "source": "src/sessions/sessionUrl.ts",
      "find": ".endsWith('.jsonl')",
      "replace": ".endsWith('.json')"
    },
    {
      "name": "url: the extension check ignores case",
      "source": "src/sessions/sessionUrl.ts",
      "find": "resumeIdentifier.toLowerCase()",
      "replace": "resumeIdentifier"
    },
    {
      "name": "url: a uuid is resumed under itself",
      "source": "src/sessions/sessionUrl.ts",
      "find": "sessionId: resumeIdentifier as UUID",
      "replace": "sessionId: randomUUID() as UUID"
    },
    {
      "name": "url: the ingress url is normalized",
      "source": "src/sessions/sessionUrl.ts",
      "find": "ingressUrl: url.href,",
      "replace": "ingressUrl: resumeIdentifier,"
    },
    {
      "name": "teleport: the process is marked teleported with the session id",
      "source": "src/sessions/hooks/useTeleportResume.tsx",
      "find": "sessionId: session.id",
      "replace": "sessionId: null"
    },
    {
      "name": "teleport: an operation error keeps its formatted message",
      "source": "src/sessions/hooks/useTeleportResume.tsx",
      "find": "formattedMessage: err instanceof TeleportOperationError ? err.formattedMessage : undefined,",
      "replace": "formattedMessage: undefined,"
    },
    {
      "name": "teleport: only operation errors are flagged as such",
      "source": "src/sessions/hooks/useTeleportResume.tsx",
      "find": "isOperationError: err instanceof TeleportOperationError",
      "replace": "isOperationError: true"
    },
    {
      "name": "teleport: other errors keep their own message",
      "source": "src/sessions/hooks/useTeleportResume.tsx",
      "find": "? err.message : errorMessage(err)",
      "replace": "? err.message : 'failed'"
    }
  ]
}
