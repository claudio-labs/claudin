{
  "test": [
    "src/sessions/resume/resume.chain.characterization.test.ts",
    "src/sessions/resume/resume.transcriptLoad.characterization.test.ts",
    "src/sessions/resume/resume.subagents.characterization.test.ts",
    "src/sessions/conversationRecovery.characterization.test.ts",
    "src/sessions/conversationRecovery.load.characterization.test.ts",
    "src/sessions/resumeLookup.characterization.test.ts"
  ],
  "source": "src/sessions/conversationRecovery.ts",
  "probes": [
    {
      "name": "recovery: the size cap is 8 MiB",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "const MAX_RESUME_MESSAGE_BYTES = 8 * 1024 * 1024",
      "replace": "const MAX_RESUME_MESSAGE_BYTES = 16 * 1024 * 1024"
    },
    {
      "name": "recovery: the size is checked before the hooks run",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "    assertResumeMessageSize(messages)\n\n    // Process session start hooks",
      "replace": "    // Process session start hooks"
    },
    {
      "name": "recovery: new_file becomes file",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "        type: 'file',",
      "replace": "        type: 'new_file',"
    },
    {
      "name": "recovery: a skill dir gets a display path",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "'skillDir' in attachment",
      "replace": "'skillDirectory' in attachment"
    },
    {
      "name": "recovery: legacy tool names are mapped",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "const name = normalizeLegacyToolName(block.name)",
      "replace": "const name = block.name"
    },
    {
      "name": "recovery: unknown permission modes are cleared",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "!validModes.has(msg.permissionMode)",
      "replace": "validModes.has(msg.permissionMode)"
    },
    {
      "name": "recovery: bedrock keeps thinking blocks",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "provider !== 'bedrock' && ",
      "replace": ""
    },
    {
      "name": "recovery: hook output does not count as an unanswered turn",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "      !isHookOutput(m) &&\n",
      "replace": "      true &&\n"
    },
    {
      "name": "recovery: the placeholder goes right after the last prompt",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "        lastRelevantIdx + 1,",
      "replace": "        filteredMessages.length,"
    },
    {
      "name": "recovery: a path resume skips sidechain tips",
      "source": "src/sessions/conversationRecovery.ts",
      "find": "if (m.isSidechain || !leafUuids.has(m.uuid)) continue",
      "replace": "if (!leafUuids.has(m.uuid)) continue"
    },
    {
      "name": "chain: the predicate filters the latest",
      "source": "src/sessions/resume/chain.ts",
      "find": "if (!predicate(m)) continue",
      "replace": "if (predicate(m)) continue"
    },
    {
      "name": "chain: the walk is returned root first",
      "source": "src/sessions/resume/chain.ts",
      "find": "  transcript.reverse()\n",
      "replace": "\n"
    },
    {
      "name": "chain: results of sibling blocks are recovered",
      "source": "src/sessions/resume/chain.ts",
      "find": "for (const tr of toolResultsByAsst.get(member.uuid) ?? []) claim(tr)",
      "replace": "void member"
    },
    {
      "name": "chain: hook output of a call is recovered",
      "source": "src/sessions/resume/chain.ts",
      "find": "for (const hook of hookOutputByToolUseId.get(toolUseId) ?? []) claim(hook)",
      "replace": "void toolUseId"
    },
    {
      "name": "chain: what follows a recovered entry comes with it",
      "source": "src/sessions/resume/chain.ts",
      "find": "for (const child of childrenByParent.get(orphanedRuns[i]!.uuid) ?? []) claim(child)",
      "replace": "void i"
    },
    {
      "name": "chain: recovered entries are in write order",
      "source": "src/sessions/resume/chain.ts",
      "find": "orphanedRuns.sort(byWriteOrder)",
      "replace": "orphanedRuns.sort((a, b) => Date.parse(a.timestamp) - Date.parse(b.timestamp))"
    },
    {
      "name": "chain: the head of a live segment follows the anchor",
      "source": "src/sessions/resume/chain.ts",
      "find": "        parentUuid: lastSeg.anchorUuid,",
      "replace": "        parentUuid: lastSeg.tailUuid,"
    },
    {
      "name": "chain: a stale segment is not spliced",
      "source": "src/sessions/resume/chain.ts",
      "find": "const segIsLive = lastSegBoundaryIdx === absoluteLastBoundaryIdx",
      "replace": "const segIsLive = true"
    },
    {
      "name": "chain: a missing anchor fails the relink",
      "source": "src/sessions/resume/chain.ts",
      "find": "if (!reachedHead || !anchorInTranscript) {",
      "replace": "if (!reachedHead) {"
    },
    {
      "name": "chain: kept replies lose their output tokens",
      "source": "src/sessions/resume/chain.ts",
      "find": "            output_tokens: 0,",
      "replace": "            output_tokens: 7,"
    },
    {
      "name": "chain: a snip relinks to the parent of the removed run",
      "source": "src/sessions/resume/chain.ts",
      "find": "deletedParent.set(uuid, entry.parentUuid)",
      "replace": "deletedParent.set(uuid, null)"
    },
    {
      "name": "load: a cost over 1e9 is rejected",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "totalCostUSD: amount.max(1e9),",
      "replace": "totalCostUSD: amount,"
    },
    {
      "name": "load: model names reject format characters",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "const COST_STATE_MODEL_NAME_RE = /^[^\\p{Cc}\\p{Cf}]+$/u",
      "replace": "const COST_STATE_MODEL_NAME_RE = /^[^\\p{Cc}]+$/u"
    },
    {
      "name": "load: a run of progress entries resolves to the message before it",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "parent && progressBridge.has(parent)",
      "replace": "false"
    },
    {
      "name": "load: a compact boundary drops earlier collapse commits",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "          contextCollapseCommits.length = 0\n",
      "replace": "\n"
    },
    {
      "name": "load: metadata before the cut is read",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "if (metadataLines && metadataLines.length > 0) {",
      "replace": "if (metadataLines && metadataLines.length > 9999) {"
    },
    {
      "name": "load: all tips keeps every branch",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "      !opts?.keepAllLeaves &&\n",
      "replace": ""
    },
    {
      "name": "load: a preserved segment disables the pre-parse walk",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "      !hasPreservedSegment &&\n",
      "replace": ""
    },
    {
      "name": "load: saved tool output is stripped",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "    buf = stripPersistedToolUseResultsFromJSONLBuffer(buf)\n",
      "replace": "\n"
    },
    {
      "name": "load: only user and assistant entries are tips",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "if (current.type === 'user' || current.type === 'assistant') {",
      "replace": "if (current.type !== 'attachment') {"
    },
    {
      "name": "load: a snapshot update replaces in place",
      "source": "src/sessions/resume/transcriptLoad.ts",
      "find": "const existingIndex = isSnapshotUpdate",
      "replace": "const existingIndex = !isSnapshotUpdate"
    },
    {
      "name": "subagents: only sidechain entries of the agent",
      "source": "src/sessions/resume/subagents.ts",
      "find": "msg => msg.agentId === agentId && msg.isSidechain,",
      "replace": "msg => msg.agentId === agentId,"
    },
    {
      "name": "subagents: the chain is filtered to the agent",
      "source": "src/sessions/resume/subagents.ts",
      "find": "const agentTranscript = transcript.filter(msg => msg.agentId === agentId)",
      "replace": "const agentTranscript = transcript"
    },
    {
      "name": "subagents: skill progress names an agent",
      "source": "src/sessions/resume/subagents.ts",
      "find": "message.data.type === 'skill_progress')",
      "replace": "message.data.type === 'agent_progress')"
    },
    {
      "name": "subagents: disk ids drop the file name frame",
      "source": "src/sessions/resume/subagents.ts",
      "find": ".map(d => d.name.slice('agent-'.length, -'.jsonl'.length))",
      "replace": ".map(d => d.name)"
    },
    {
      "name": "cache: one set per session",
      "source": "src/sessions/resume/cache.ts",
      "find": "(sessionId: UUID) => sessionId,",
      "replace": "() => 'every session',"
    },
    {
      "name": "cache: clearing forgets the sets",
      "source": "src/sessions/resume/cache.ts",
      "find": "getSessionMessages.cache.clear?.()",
      "replace": "void 0"
    },
    {
      "name": "candidates: only uuid names",
      "source": "src/sessions/sessionCandidates.ts",
      "find": "const sessionId = validateUuid(name.slice(0, -6))",
      "replace": "const sessionId = name.slice(0, -6)"
    },
    {
      "name": "candidates: mtime is in ms",
      "source": "src/sessions/sessionCandidates.ts",
      "find": "mtime: s.mtime.getTime(), projectPath",
      "replace": "mtime: Math.floor(s.mtime.getTime() / 1000), projectPath"
    },
    {
      "name": "cross: the directory is shell-quoted",
      "source": "src/sessions/crossProjectResume.ts",
      "find": "cd ${quote([log.projectPath])}",
      "replace": "cd ${log.projectPath}"
    }
  ]
}
