      "source": "src/memory/instructions/ruleMapAutoSync.ts",
      "find": "    if (trackedFiles === null) return { status: 'skipped', reason: 'error' }",
      "replace": "    if (trackedFiles === null) return { status: 'skipped', reason: 'not a git repo' }"
