{
  "test": [
    "src/memory/instructions/",
    "src/commands/init.test.ts",
    "src/commands/map/",
    "src/agent/tasks/RuleMapTask/",
    "src/agent/tasks/framework.hold.test.ts",
    "src/agent/ui/tasks/"
  ],
  "source": "src/memory/instructions/ruleMapScheduler.ts",
  "probes": [
    {
      "name": "the scheduler is a no-op until initialized",
      "find": "  const d = deps\n  if (d === null) return Promise.resolve()",
      "replace": "  const d = deps ?? defaultDeps()"
    },
    {
      "name": "an unchanged fingerprint skips the turn",
      "find": "if (before !== null && fingerprintKey(before) === lastFingerprint) return",
      "replace": "if (false) return"
    },
    {
      "name": "a write takes in the map stat it produced",
      "find": ": fingerprintKey({ index: before.index, map: after.map })",
      "replace": ": fingerprintKey(before)"
    },
    {
      "name": "a write does not absorb an index change made while it ran",
      "find": ": fingerprintKey({ index: before.index, map: after.map })",
      "replace": ": fingerprintKey(after)"
    },
    {
      "name": "a command's sync does not absorb an index change either",
      "find": "        await remember(d, root, before, outcome)",
      "replace": "        await remember(d, root, await d.fingerprint(root), outcome)"
    },
    {
      "name": "a failed run is retried next turn",
      "find": "    before === null ||\n    (outcome.status === 'skipped' && outcome.reason === 'error')\n",
      "replace": "    before === null\n"
    },
    {
      "name": "a turn ending mid-sync joins it",
      "find": "if (inFlight === null) void exclusive(() => runTurn(d, turn))",
      "replace": "void runTurn(d, turn)"
    },
    {
      "name": "a command waits for a turn already syncing",
      "find": "  while (inFlight !== null) await inFlight\n  const run = work()",
      "replace": "  const run = work()"
    },
    {
      "name": "the headless drain waits for a queued sync too",
      "find": "export async function drainPendingRuleMapSync(): Promise<void> {\n  while (inFlight !== null) await inFlight\n}",
      "replace": "export async function drainPendingRuleMapSync(): Promise<void> {\n  await inFlight\n}"
    },
    {
      "name": "/map off stops the end-of-turn sync",
      "find": "    if (d.disabledForProject()) return\n",
      "replace": ""
    },
    {
      "name": "/init respects /map off",
      "find": "      if (respectSwitch && d.disabledForProject()) {",
      "replace": "      if (false) {"
    },
    {
      "name": "a caller that reports the outcome gets no notice",
      "find": "  if (outcome.status === 'skipped' || turn.announce === false) return outcome\n",
      "replace": "  if (outcome.status === 'skipped') return outcome\n"
    },
    {
      "name": "headless registers no footer task",
      "find": "const setAppState = d.interactive() ? turn.setAppState : undefined",
      "replace": "const setAppState = turn.setAppState"
    },
    {
      "name": "a modification this module made is not the user's",
      "source": "src/memory/instructions/ruleMapAutoSync.ts",
      "find": "return committed === null || !isHealerOnlyDiff(committed, working, trackedFiles)",
      "replace": "return true"
    },
    {
      "name": "a staged, never-committed map falls back to the index",
