{
  "test": ["src/skills/bundled/updateConfig.test.ts"],
  "source": "src/skills/bundled/updateConfig.ts",
  "probes": [
    {
      "name": "the hooks-only branch is skipped",
      "find": "if (args.startsWith('[hooks-only]')) {",
      "replace": "if (args.startsWith('[never]')) {"
    },
    {
      "name": "the hooks-only branch drops the verification flow",
      "find": "let prompt = HOOKS_DOCS + '\\n\\n' + HOOK_VERIFICATION_FLOW",
      "replace": "let prompt = HOOKS_DOCS"
    },
    {
      "name": "the hooks-only request is dropped",
      "find": "prompt += `\\n\\n## Task\\n\\n${req}`",
      "replace": "prompt += ''"
    },
    {
      "name": "a line of the verification flow changes",
      "source": "src/skills/bundled/hookDocs.ts",
      "find": "1. **Dedup check.** Read the target file.",
      "replace": "1. **Dedup check.** Open the target file."
    },
    {
      "name": "the events table stops appending the schema's other events",
      "source": "src/skills/bundled/hookDocs.ts",
      "find": "return [HAND_WRITTEN_EVENT_ROWS, ...generated].join('\\n')",
      "replace": "return HAND_WRITTEN_EVENT_ROWS"
    },
    {
      "name": "a generated row loses its matcher",
      "source": "src/skills/bundled/hookDocs.ts",
      "find": "return matcher.values.map(value => `\"${value}\"`).join('/')",
      "replace": "return '-'"
    },
    {
      "name": "the http hook type goes undocumented",
      "source": "src/skills/bundled/hookDocs.ts",
      "find": "{ \"type\": \"http\", \"url\"",
      "replace": "{ \"url\""
    },
    {
      "name": "the full prompt drops the hook reference",
      "find": "${HOOKS_DOCS}\n",
      "replace": "\n"
    }
  ]
}
