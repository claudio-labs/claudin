{
  "test": "src/tools/AgentTool/subagentThinking.test.ts",
  "source": "src/tools/AgentTool/subagentThinking.ts",
  "probes": [
    {
      "name": "effort cap: a higher parent is lowered to the cap",
      "find": "  return EFFORT_LEVELS.indexOf(parent) > EFFORT_LEVELS.indexOf(cap) ? cap : parent\n",
      "replace": "  return parent\n"
    },
    {
      "name": "effort cap: a lower parent is never raised",
      "find": "  return EFFORT_LEVELS.indexOf(parent) > EFFORT_LEVELS.indexOf(cap) ? cap : parent\n",
      "replace": "  return cap\n"
    },
    {
      "name": "effort cap: a fork keeps the parent's effort",
      "find": "  if (useExactTools) return parent\n  const cap = subagentEffortCap()\n",
      "replace": "  const cap = subagentEffortCap()\n"
    },
    {
      "name": "effort cap: on by default at high",
      "find": "  if (!raw) return DEFAULT_SUBAGENT_EFFORT_CAP\n",
      "replace": "  if (!raw) return null\n"
    },
    {
      "name": "effort cap: off disables it",
      "find": "  if (raw === 'off' || isEnvDefinedFalsy(raw)) return null\n",
      "replace": "\n"
    },
    {
      "name": "effort cap: runAgent routes the parent effort through it",
      "source": "src/tools/AgentTool/runAgent.ts",
      "find": "        : subagentEffort(state.effortValue, { useExactTools: useExactTools === true })\n",
      "replace": "        : state.effortValue\n"
    }
  ]
}
