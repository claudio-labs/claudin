{
  "test": ["src/memory/memdir/teamMemSecretGuard.test.ts"],
  "source": "src/memory/memdir/teamMemPaths.ts",
  "probes": [
    {
      "name": "the prefix test keeps its trailing separator, so team-old/ is not team/",
      "find": "  return resolvedPath.startsWith(teamDir)\n",
      "replace": "  return resolvedPath.startsWith(teamDir.replace(/[/\\\\]$/, ''))\n"
    },
    {
      "name": "the path is resolved before the prefix test, so a traversal cannot stay inside",
      "find": "  const resolvedPath = resolve(filePath)\n",
      "replace": "  const resolvedPath = filePath\n"
    },
    {
      "name": "the AWS rule fires on the AKIA prefix",
      "source": "src/memory/memdir/secretScanner.ts",
      "find": "    source: '\\\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\\\b',\n",
      "replace": "    source: '\\\\b((?:A3T[A-Z0-9]|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\\\b',\n"
    },
    {
      "name": "labels keep the vendor's own capitalization",
      "source": "src/memory/memdir/secretScanner.ts",
      "find": "    github: 'GitHub',\n",
      "replace": ""
    },
    {
      "name": "a match carries the rule, never the matched text",
      "source": "src/memory/memdir/secretScanner.ts",
      "find": "        label: ruleIdToLabel(rule.id),\n      })\n",
      "replace": "        label: ruleIdToLabel(rule.id),\n        text: content,\n      } as SecretMatch)\n"
    }
  ]
}
