// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`Read input schema — CLAUDIN_READ_MULTI off the JSON schema the API receives is pinned byte for byte 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_path": {
      "type": "string",
      "description": "The absolute path to the file to read"
    },
    "offset": {
      "description": "Line number to start reading from.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Number of lines to read.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pages": {
      "description": "PDF page range, e.g. \\"1-5\\" or \\"3\\"; at most 20 pages per request.",
      "type": "string"
    },
    "view": {
      "description": "'outline': only the file's skeleton — every function, class and object-literal member signature with its line range. 'full': the whole body, even of a large file that would otherwise come back as an outline.",
      "type": "string",
      "enum": [
        "outline",
        "full"
      ]
    },
    "symbol": {
      "description": "One symbol's body by name — a function, class or type — with its real line numbers. Takes precedence over offset/limit and view.",
      "type": "string"
    },
    "encoding": {
      "description": "Encoding Standard label to decode with instead of UTF-8 (e.g. \\"utf-16le\\", \\"shift_jis\\", \\"windows-1252\\"), for a file that is not UTF-8 and has no BOM. The same labels as Grep's \`encoding\`.",
      "type": "string"
    }
  },
  "required": [
    "file_path"
  ],
  "additionalProperties": false
}"
`;

exports[`Read input schema — the default, CLAUDIN_READ_MULTI unset the JSON schema the API receives is pinned byte for byte 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_path": {
      "description": "The absolute path to the file to read. Give this or file_paths, not both.",
      "type": "string"
    },
    "file_paths": {
      "description": "2-20 absolute paths to read in one call, instead of file_path; offset, limit, pages and encoding are single-file only.",
      "minItems": 2,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offset": {
      "description": "Line number to start reading from.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "description": "Number of lines to read.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pages": {
      "description": "PDF page range, e.g. \\"1-5\\" or \\"3\\"; at most 20 pages per request.",
      "type": "string"
    },
    "view": {
      "description": "'outline': only the file's skeleton — every function, class and object-literal member signature with its line range. 'full': the whole body, even of a large file that would otherwise come back as an outline.",
      "type": "string",
      "enum": [
        "outline",
        "full"
      ]
    },
    "symbol": {
      "description": "A symbol's body by name — a function, class or type — with its real line numbers; or a list of up to 10, each looked up in every file. Takes precedence over offset/limit and view.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "encoding": {
      "description": "Encoding Standard label to decode with instead of UTF-8 (e.g. \\"utf-16le\\", \\"shift_jis\\", \\"windows-1252\\"), for a file that is not UTF-8 and has no BOM. The same labels as Grep's \`encoding\`.",
      "type": "string"
    }
  },
  "additionalProperties": false
}"
`;
